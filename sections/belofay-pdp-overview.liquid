<section id="belofay-overview" class="belofay-pdp__section">
  <div class="belofay-pdp__shell">
    <p class="belofay-pdp__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="belofay-pdp__heading">{{ section.settings.heading }}</h2>
    <p class="belofay-pdp__lede">{{ section.settings.text }}</p>
    <div class="belofay-pdp__grid belofay-pdp__grid--3" style="margin-top:var(--ds-space-xl)">
      {%- for block in section.blocks -%}
        <article class="belofay-pdp__card belofay-pdp__feature" {{ block.shopify_attributes }}>
          {% render 'belofay-pdp-icon', name: block.settings.icon %}<h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
    <div class="belofay-pdp-overview__content">
      <div class="belofay-pdp__card belofay-pdp-overview__visual">
        {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', loading: 'lazy', sizes: '(min-width: 990px) 60vw, 100vw' }}{%- else -%}<div class="belofay-pdp__media-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>{%- endif -%}
      </div>
      <div class="belofay-pdp-overview__stack">
        <article class="belofay-pdp__card belofay-pdp__feature"><h3>{{ section.settings.storage_heading }}</h3><p>{{ section.settings.storage_text }}</p></article>
        <article class="belofay-pdp__card belofay-pdp__feature" style="background:var(--ds-bg-success)"><h3>{{ section.settings.included_heading }}</h3><ul class="belofay-pdp__check-list"><li><span class="belofay-pdp__check">✓</span>Ceramic basin</li><li><span class="belofay-pdp__check">✓</span>Chrome waste</li><li><span class="belofay-pdp__check">✓</span>Vanity cabinet</li></ul></article>
        <details class="belofay-pdp__card belofay-pdp__feature"><summary>{{ section.settings.materials_heading }}</summary><p>{{ section.settings.materials_text }}</p></details>
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Belofay PDP overview","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BELOFAY"},{"type":"text","id":"heading","label":"Heading","default":"A compact vanity made for everyday bathrooms"},{"type":"textarea","id":"text","label":"Introduction","default":"Modern style, practical storage and a durable, easy-care finish — designed for real homes."},{"type":"image_picker","id":"image","label":"Lifestyle image"},{"type":"text","id":"storage_heading","label":"Storage heading","default":"Practical storage for everyday essentials"},{"type":"textarea","id":"storage_text","label":"Storage text","default":"Keep your bathroom organised with a spacious cabinet for toiletries, towels and more."},{"type":"text","id":"included_heading","label":"Included heading","default":"What’s included"},{"type":"text","id":"materials_heading","label":"Materials heading","default":"Materials & finish"},{"type":"textarea","id":"materials_text","label":"Materials text","default":"Moisture-resistant painted cabinet, soft-close metal hinges and easy-clean surfaces."}],"blocks":[{"type":"feature","name":"Feature","limit":3,"settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"measure","label":"Measure"},{"value":"shield","label":"Shield"},{"value":"check","label":"Check"}],"default":"check"},{"type":"text","id":"heading","label":"Heading","default":"Soft-close doors"},{"type":"text","id":"text","label":"Text","default":"Quiet, smooth everyday operation"}]}],"presets":[{"name":"Belofay PDP overview","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]}
{% endschema %}

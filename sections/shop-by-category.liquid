{% comment %}
  Shop by Category — grid of collection tiles with uppercase titles and "Shop Now" links.
{% endcomment %}

<div class="sbc page-width" style="padding-top: {{ section.settings.padding_top | default: 24 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 24 }}px;">
  <h2 class="sbc__heading">{{ section.settings.heading }}</h2>
  <div class="sbc__grid" style="--sbc-cols: {{ section.settings.columns | default: 6 }};">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      {%- if col != blank -%}
        <a href="{{ col.url }}" class="sbc__tile" {{ block.shopify_attributes }}>
          <div class="sbc__image-wrap">
            {%- assign img = block.settings.image | default: col.featured_image -%}
            {%- if img != blank -%}
              {{ img | image_url: width: 600 | image_tag: class: 'sbc__image', loading: 'lazy', sizes: '(min-width: 990px) 16vw, 45vw', widths: '300, 450, 600' }}
            {%- else -%}
              <div class="sbc__image sbc__image--placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          <span class="sbc__title">{{ block.settings.label | default: col.title }}</span>
          <span class="sbc__cta">Shop Now <span aria-hidden="true">&rarr;</span></span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .sbc {
    padding-top: 24px;
    padding-bottom: 24px;
    margin-top: 24px;
    margin-bottom: 24px;
  }

  .sbc__heading {
    margin: 0 0 28px;
    text-align: center;
    font-size: clamp(1.9rem, 2vw, 2.4rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #191919;
  }

  .sbc__grid {
    display: grid;
    grid-template-columns: repeat(var(--sbc-cols, 6), 1fr);
    gap: 22px;
  }

  .sbc__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .sbc__image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1.05;
    overflow: hidden;
    background: #f4f2ee;
  }

  .sbc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .sbc__tile:hover .sbc__image {
    transform: scale(1.04);
  }

  .sbc__title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #191919;
    text-align: center;
  }

  .sbc__cta {
    font-size: 1.1rem;
    color: #4a4a4a;
  }

  .sbc__tile:hover .sbc__cta {
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    .sbc__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 649px) {
    .sbc__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 3, "max": 7, "step": 1, "default": 7 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Custom label (optional)" },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Shop by category" }]
}
{% endschema %}

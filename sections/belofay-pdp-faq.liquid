<section id="belofay-faq" class="belofay-pdp__section" style="background:var(--ds-bg-surface)">
  <div class="belofay-pdp__shell"><p class="belofay-pdp__eyebrow">{{ section.settings.eyebrow }}</p><h2 class="belofay-pdp__heading">{{ section.settings.heading }}</h2><p class="belofay-pdp__lede">{{ section.settings.text }}</p>
    <div class="belofay-pdp-faq__layout"><div class="belofay-pdp__card belofay-pdp-faq__list">{%- for block in section.blocks -%}<details class="belofay-pdp__accordion" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ forloop.index | prepend: '0' }} &nbsp; {{ block.settings.question }}</summary><div class="belofay-pdp__accordion-content">{{ block.settings.answer }}</div></details>{%- endfor -%}</div><aside class="belofay-pdp__card belofay-pdp-faq__contact"><p class="belofay-pdp__eyebrow">{{ section.settings.contact_eyebrow }}</p><h3>{{ section.settings.contact_heading }}</h3><p>{{ section.settings.contact_text }}</p><textarea aria-label="Question" maxlength="300" placeholder="Type your question about this product"></textarea><button type="button">Ask a question →</button></aside></div>
  </div>
</section>
{% schema %}
{"name":"Belofay PDP FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FAQ"},{"type":"text","id":"heading","label":"Heading","default":"Frequently Asked Questions"},{"type":"textarea","id":"text","label":"Introduction","default":"Quick answers about this product. Can’t find what you’re looking for? Ask our team."},{"type":"text","id":"contact_eyebrow","label":"Contact eyebrow","default":"STILL HAVE A QUESTION?"},{"type":"text","id":"contact_heading","label":"Contact heading","default":"Ask BELOFAY"},{"type":"textarea","id":"contact_text","label":"Contact text","default":"Our UK support team can help with product details, compatibility and installation."}],"blocks":[{"type":"question","name":"Question","limit":12,"settings":[{"type":"text","id":"question","label":"Question","default":"What is included with this vanity?"},{"type":"textarea","id":"answer","label":"Answer","default":"The vanity cabinet, ceramic basin and chrome waste are included."}]}],"presets":[{"name":"Belofay PDP FAQ","blocks":[{"type":"question"},{"type":"question"},{"type":"question"},{"type":"question"}]}]}
{% endschema %}

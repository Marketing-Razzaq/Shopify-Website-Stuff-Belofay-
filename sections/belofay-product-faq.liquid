<section id="faqs" class="belofay-faq" data-faq-section>
  <div class="belofay-faq__shell">
    <details class="belofay-faq__outer" data-faq-outer open>
      <summary class="belofay-faq__outer-summary"><span><strong>{{ section.settings.heading }}</strong><small>{{ section.settings.mobile_summary }}</small></span><i aria-hidden="true"></i></summary>
      <div class="belofay-faq__body">
    <header class="belofay-faq__header"><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.intro }}</div></header>
    <div class="belofay-faq__layout">
      <div class="belofay-faq__primary">
        <div class="belofay-faq__list">
          {%- assign faq_number = 0 -%}
          {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}{%- assign faq_number = faq_number | plus: 1 -%}
            <details name="faq-{{ section.id }}"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
              <summary><b>{{ faq_number | prepend: '0' | slice: -2, 2 }}</b><strong>{{ block.settings.question }}</strong><i><span>{% render 'belofay-faq-icon', name: 'plus' %}</span><span>{% render 'belofay-faq-icon', name: 'minus' %}</span></i></summary>
              <div class="belofay-faq__answer">
                {%- if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank -%}<div class="belofay-faq__images">
                  {%- for index in (1..3) -%}{%- assign image_key = 'image_' | append: index -%}{%- assign label_key = image_key | append: '_label' -%}{%- assign answer_image = block.settings[image_key] -%}{%- if answer_image != blank -%}<figure>{{ answer_image | image_url: width: 500 | image_tag: widths: '180,260,360,500', loading: 'lazy', alt: block.settings[label_key] }}<figcaption>{{ block.settings[label_key] }}</figcaption></figure>{%- endif -%}{%- endfor -%}
                </div>{%- endif -%}
                <div class="belofay-faq__copy">{{ block.settings.answer }}{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label }} →</a>{% endif %}</div>
              </div>
            </details>
          {%- endif -%}{%- endfor -%}
        </div>
        <aside class="belofay-faq__help">{% render 'belofay-faq-icon', name: 'chat' %}<span><strong>{{ section.settings.help_heading }}</strong><small>{{ section.settings.help_text }}</small></span>{% if section.settings.help_link != blank %}<a href="{{ section.settings.help_link }}">{{ section.settings.help_label }} →</a>{% endif %}</aside>
      </div>
      <aside class="belofay-faq__aside">
        <div class="belofay-faq__contact">
          <header>{% render 'belofay-faq-icon', name: 'chat' %}<div><p>{{ section.settings.contact_eyebrow }}</p><h3>{{ section.settings.contact_heading }}</h3><span>{{ section.settings.contact_text }}</span></div></header>
          {%- form 'contact', id: 'BelofayFaqContact' -%}
            <input type="hidden" name="contact[product]" value="{{ product.title | escape }}"><input type="hidden" name="contact[product_url]" value="{{ canonical_url }}">
            <label for="FaqEmail-{{ section.id }}">{{ section.settings.email_label }}</label><input id="FaqEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
            <label for="FaqQuestion-{{ section.id }}">{{ section.settings.question_label }}</label><textarea id="FaqQuestion-{{ section.id }}" name="contact[body]" maxlength="300" placeholder="{{ section.settings.question_placeholder }}" required data-faq-question></textarea><output for="FaqQuestion-{{ section.id }}" data-faq-count>0/300</output>
            {%- if form.posted_successfully? -%}<p class="belofay-faq__status" tabindex="-1">{{ section.settings.success_text }}</p>{%- endif -%}{{ form.errors | default_errors }}
            <button type="submit" data-faq-submit><span>{{ section.settings.submit_label }} →</span><i aria-hidden="true"></i></button>
          {%- endform -%}
          <div class="belofay-faq__assurances"><span>{% render 'belofay-faq-icon', name: 'clock' %}<small>{{ section.settings.response_text }}</small></span><span>{% render 'belofay-faq-icon', name: 'support' %}<small>{{ section.settings.team_text }}</small></span><span>{% render 'belofay-faq-icon', name: 'shield' %}<small>{{ section.settings.advice_text }}</small></span></div>
        </div>
        <div class="belofay-faq__popular"><p>{{ section.settings.popular_eyebrow }}</p><h3>{{ section.settings.popular_heading }}</h3><div>
          {%- for block in section.blocks -%}{%- if block.type == 'customer_question' -%}<details name="customer-faq-{{ section.id }}" {{ block.shopify_attributes }}><summary>{% render 'belofay-faq-icon', name: 'chat' %}<span><strong>{{ block.settings.question }}</strong><small>{{ block.settings.byline }}</small></span><i></i></summary><div class="belofay-faq__customer-answer">{{ block.settings.answer }}{% if block.settings.answer_date != blank %}<small>{{ block.settings.byline }} · {{ block.settings.answer_date }}</small>{% endif %}</div></details>{%- endif -%}{%- endfor -%}
        </div>{% if section.settings.popular_link != blank %}<a href="{{ section.settings.popular_link }}">{{ section.settings.popular_label }} →</a>{% endif %}</div>
      </aside>
    </div>
      </div>
    </details>
  </div>
</section>

{% stylesheet %}
  .belofay-faq { scroll-margin-top: 118px; color: var(--ds-text-strong); background: var(--ds-bg-page); font-family: var(--ds-font-body),Arial,sans-serif; }
  .belofay-faq *, .belofay-faq *::before, .belofay-faq *::after { box-sizing: border-box; }
  .belofay-faq__shell { max-width: 1600px; margin: 0 auto; padding: var(--ds-space-2xl) var(--ds-space-xl) var(--ds-space-section); }
  .belofay-faq__outer-summary { display: none; }
  .belofay-faq h2, .belofay-faq h3, .belofay-faq p { margin-top: 0; }
  .belofay-faq__header { margin-bottom: var(--ds-space-lg); }
  .belofay-faq__header > p, .belofay-faq__contact header p, .belofay-faq__popular > p { margin-bottom: var(--ds-space-xs); color: var(--ds-action-primary-hover); font-size: var(--ds-text-sm); font-weight: var(--ds-weight-bold); letter-spacing: .16em; text-transform: uppercase; }
  .belofay-faq__header h2 { margin-bottom: 10px; color: var(--ds-text-heading); font: var(--ds-weight-bold) clamp(30px,2.25vw,42px)/1.08 var(--ds-font-heading); letter-spacing: -.03em; }
  .belofay-faq__header > div { max-width: 820px; color: var(--ds-text-supporting); font: var(--ds-weight-regular) 19px/1.45 var(--ds-font-body); }
  .belofay-faq__layout { display: grid; grid-template-columns: minmax(0,1.8fr) minmax(420px,.92fr); gap: var(--ds-space-lg); align-items: start; }
  .belofay-faq__primary, .belofay-faq__aside { min-width: 0; display: grid; gap: var(--ds-space-md); }
  .belofay-faq__list, .belofay-faq__contact, .belofay-faq__popular, .belofay-faq__help { border: 1px solid var(--ds-border-default); border-radius: var(--ds-radius-card); background: var(--ds-bg-page); }
  .belofay-faq__list { overflow: clip; padding: 8px; }
  .belofay-faq__list details { overflow: clip; border-bottom: 1px solid var(--ds-border-default); transition: border-color var(--motion-duration-base) var(--motion-ease-standard), background-color var(--motion-duration-base) var(--motion-ease-standard); }
  .belofay-faq__list details:last-child { border-bottom: 0; }
  .belofay-faq__list details[open] { margin-bottom: 8px; border: 1px solid color-mix(in srgb,var(--ds-action-primary),var(--ds-border-default) 45%); border-radius: var(--ds-radius-control); background: var(--ds-surface-expanded); }
  .belofay-faq summary { list-style: none; cursor: pointer; }
  .belofay-faq summary::-webkit-details-marker { display: none; }
  .belofay-faq__list summary { min-height: 64px; display: grid; grid-template-columns: 44px minmax(0,1fr) 44px; align-items: center; gap: var(--ds-space-sm); padding: 10px var(--ds-space-md); transition: color var(--motion-duration-fast) var(--motion-ease-standard), background-color var(--motion-duration-fast) var(--motion-ease-standard), transform var(--motion-duration-fast) var(--motion-ease-standard); }
  .belofay-faq__list summary:hover { color: var(--ds-action-primary-hover); background: var(--ds-control-selected-bg); }
  .belofay-faq summary:active { transform: scale(var(--motion-press-scale)); }
  .belofay-faq__list summary > b, .belofay-faq__list summary > i { display: grid; place-items: center; border-radius: 50%; }
  .belofay-faq__list summary > b { width: 44px; height: 44px; color: var(--ds-action-primary-hover); background: var(--ds-bg-success); }
  .belofay-faq__list summary strong { color: var(--ds-text-heading); font: var(--ds-weight-semibold) var(--ds-text-lg)/1.25 var(--ds-font-heading); }
  .belofay-faq__list summary > i { width: 38px; height: 38px; justify-self: end; color: var(--ds-text-heading); background: var(--ds-bg-surface); }
  .belofay-faq__list summary > i > span:last-child, .belofay-faq__list details[open] summary > i > span:first-child { display: none; }
  .belofay-faq__list details[open] summary > i > span:last-child { display: block; }
  .belofay-faq__icon { width: 28px; height: 28px; display: grid; place-items: center; color: currentColor; }
  .belofay-faq__icon svg { width: 100%; height: 100%; display: block; }
  .belofay-faq__icon path { fill: currentColor; }
  .belofay-faq__list summary .belofay-faq__icon { width: 18px; height: 18px; }
  .belofay-faq__answer { display: grid; grid-template-columns: minmax(280px,1.05fr) minmax(0,.95fr); gap: var(--ds-space-md); padding: var(--ds-space-md); border-top: 1px solid var(--ds-border-default); }
  .belofay-faq__images { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: var(--ds-space-xs); padding: var(--ds-space-sm); border-radius: var(--ds-radius-control); background: var(--ds-bg-page); }
  .belofay-faq__images figure { min-width: 0; margin: 0; text-align: center; }
  .belofay-faq__images img { width: 100%; height: 110px; object-fit: contain; }
  .belofay-faq__images figcaption { color: var(--ds-text-heading); font-size: var(--ds-text-sm); }
  .belofay-faq__copy { color: var(--ds-text-supporting); line-height: 1.5; }
  .belofay-faq__copy a, .belofay-faq__popular > a { display: inline-flex; margin-top: var(--ds-space-sm); color: var(--ds-action-primary-hover); font-weight: var(--ds-weight-semibold); text-underline-offset: 3px; }
  .belofay-faq__help { min-height: 88px; display: grid; grid-template-columns: 44px minmax(0,1fr) auto; align-items: center; gap: var(--ds-space-md); padding: var(--ds-space-md); background: var(--ds-bg-surface); }
  .belofay-faq__help > span { display: grid; gap: 2px; }
  .belofay-faq__help strong { color: var(--ds-text-heading); }
  .belofay-faq__help small { color: var(--ds-text-supporting); }
  .belofay-faq__help a { min-height: 44px; display: flex; align-items: center; padding: 8px var(--ds-space-lg); border: 1px solid var(--ds-action-primary); border-radius: var(--ds-radius-control); color: var(--ds-text-heading); text-decoration: none; }
  .belofay-faq__contact, .belofay-faq__popular { padding: var(--ds-space-lg); }
  .belofay-faq__contact { background: var(--ds-bg-success); }
  .belofay-faq__contact header { display: grid; grid-template-columns: 48px minmax(0,1fr); gap: var(--ds-space-sm); }
  .belofay-faq__contact header .belofay-faq__icon { color: var(--ds-action-primary-hover); }
  .belofay-faq__contact h3, .belofay-faq__popular h3 { margin-bottom: var(--ds-space-xs); color: var(--ds-text-heading); font: var(--ds-weight-bold) var(--ds-text-xl)/1.15 var(--ds-font-heading); }
  .belofay-faq__contact header span { color: var(--ds-text-supporting); line-height: 1.45; }
  .belofay-faq__contact form { display: grid; grid-template-columns: 1fr auto; gap: 6px; margin-top: var(--ds-space-md); }
  .belofay-faq__contact label { color: var(--ds-text-heading); font-weight: var(--ds-weight-semibold); }
  .belofay-faq__contact label, .belofay-faq__contact input, .belofay-faq__contact textarea, .belofay-faq__contact button, .belofay-faq__status, .belofay-faq__contact .errors { grid-column: 1 / -1; }
  .belofay-faq__contact input, .belofay-faq__contact textarea { width: 100%; padding: var(--ds-space-sm); border: 1px solid var(--ds-control-border); border-radius: var(--ds-radius-control); color: var(--ds-text-heading); background: var(--ds-bg-page); font: var(--ds-weight-regular) var(--ds-text-md)/1.4 var(--ds-font-body); }
  .belofay-faq__contact textarea { min-height: 112px; resize: vertical; }
  .belofay-faq__contact output { grid-column: 2; color: var(--ds-text-supporting); font-size: var(--ds-text-sm); }
  .belofay-faq__contact button { position: relative; min-height: 52px; display: flex; align-items: center; justify-content: center; padding: 0 var(--ds-space-md); border: 0; border-radius: var(--ds-radius-control); color: var(--ds-text-on-primary); background: var(--ds-action-primary); font: var(--ds-weight-semibold) var(--ds-text-md)/1 var(--ds-font-body); text-align: center; cursor: pointer; transition: transform var(--motion-duration-fast) var(--motion-ease-standard), background-color var(--motion-duration-fast) var(--motion-ease-standard); }
  .belofay-faq__contact button:hover { background: var(--ds-action-primary-hover); transform: translateY(var(--motion-hover-lift)); }
  .belofay-faq__contact button[aria-busy=true] span { opacity: 0; }
  .belofay-faq__contact button[aria-busy=true] i { position: absolute; width: 20px; height: 20px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: belofay-faq-spin var(--motion-duration-loading) linear infinite; }
  .belofay-faq__assurances { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); margin-top: var(--ds-space-md); }
  .belofay-faq__assurances > span { min-width: 0; display: grid; justify-items: center; gap: 6px; padding: 0 8px; border-right: 1px solid var(--ds-border-default); text-align: center; }
  .belofay-faq__assurances > span:last-child { border-right: 0; }
  .belofay-faq__assurances .belofay-faq__icon { color: var(--ds-action-primary-hover); }
  .belofay-faq__assurances small { color: var(--ds-text-heading); font-size: var(--ds-text-sm); line-height: 1.3; }
  .belofay-faq__popular details { border-bottom: 1px solid var(--ds-border-default); }
  .belofay-faq__popular summary { min-height: 74px; display: grid; grid-template-columns: 48px minmax(0,1fr) auto; align-items: center; gap: var(--ds-space-sm); padding: var(--ds-space-xs) 0; transition: color var(--motion-duration-fast) var(--motion-ease-standard), transform var(--motion-duration-fast) var(--motion-ease-standard); }
  .belofay-faq__popular summary:hover { color: var(--ds-action-primary-hover); }
  .belofay-faq__popular summary > .belofay-faq__icon { width: 44px; height: 44px; padding: 10px; border-radius: 50%; color: var(--ds-action-primary-hover); background: var(--ds-bg-success); }
  .belofay-faq__popular summary > span { display: grid; gap: 3px; }
  .belofay-faq__popular summary strong { color: var(--ds-text-heading); line-height: 1.25; }
  .belofay-faq__popular summary small, .belofay-faq__customer-answer { color: var(--ds-text-supporting); }
  .belofay-faq__popular summary > i { width: 10px; height: 10px; border-top: 2px solid var(--ds-text-heading); border-right: 2px solid var(--ds-text-heading); transform: rotate(45deg); transition: transform var(--motion-duration-base) var(--motion-ease-standard); }
  .belofay-faq__popular details[open] summary > i { transform: rotate(-45deg); }
  .belofay-faq__customer-answer { margin-bottom: var(--ds-space-sm); padding: var(--ds-space-md); border-radius: var(--ds-radius-control); background: var(--ds-surface-expanded); line-height: 1.5; }
  .belofay-faq__customer-answer small { display: block; margin-top: var(--ds-space-sm); }
  .belofay-faq summary:focus-visible, .belofay-faq a:focus-visible, .belofay-faq button:focus-visible, .belofay-faq input:focus-visible, .belofay-faq textarea:focus-visible { outline: 3px solid color-mix(in srgb,var(--ds-action-primary),transparent 55%); outline-offset: 2px; }
  @supports selector(details::details-content) { .belofay-faq details::details-content { block-size: 0; opacity: 0; overflow: clip; transition: block-size var(--motion-duration-base) var(--motion-ease-emphasized), opacity var(--motion-duration-fast) var(--motion-ease-standard), content-visibility var(--motion-duration-base) allow-discrete; } .belofay-faq details[open]::details-content { block-size: auto; opacity: 1; } }
  @media (max-width: 1440px) and (min-width: 1025px) { .belofay-faq__layout { grid-template-columns: 1fr; } .belofay-faq__aside { grid-template-columns: minmax(0,1fr) minmax(0,1fr); align-items: start; } .belofay-faq__answer { grid-template-columns: minmax(280px,1.05fr) minmax(0,.95fr); } }
  @media (max-width: 1024px) { .belofay-faq { scroll-margin-top: 104px; } .belofay-faq__shell { width: auto; padding: 6px var(--ds-space-md) var(--ds-space-xl); } .belofay-faq__outer { overflow: clip; border: 1px solid var(--ds-control-border); border-radius: var(--ds-radius-card); background: var(--ds-bg-page); transition: border-color var(--motion-duration-base) var(--motion-ease-standard), background-color var(--motion-duration-base) var(--motion-ease-standard); } .belofay-faq__outer[open] { border-color: color-mix(in srgb,var(--ds-action-primary),var(--ds-border-default) 55%); background: color-mix(in srgb,var(--ds-bg-surface),var(--ds-bg-page) 65%); } .belofay-faq__outer-summary { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 16px; cursor: pointer; list-style: none; transition: color var(--motion-duration-fast) var(--motion-ease-standard), background-color var(--motion-duration-fast) var(--motion-ease-standard), transform var(--motion-duration-fast) var(--motion-ease-standard); } .belofay-faq__outer-summary > span { display: grid; } .belofay-faq__outer-summary strong { color: var(--ds-text-heading); font: var(--ds-weight-semibold) 19px/1.2 var(--ds-font-heading); } .belofay-faq__outer-summary small { margin-top: 2px; color: var(--ds-text-supporting); font: var(--ds-weight-regular) var(--ds-text-sm)/1.25 var(--ds-font-body); } .belofay-faq__outer-summary > i { width: 10px; height: 10px; border-right: 2px solid; border-bottom: 2px solid; transform: rotate(45deg); transition: transform var(--motion-duration-base) var(--motion-ease-standard); } .belofay-faq__outer[open] > summary > i { transform: rotate(225deg); } .belofay-faq__outer-summary:hover { color: var(--ds-action-primary-hover); background: var(--ds-control-selected-bg); } .belofay-faq__body { padding: var(--ds-space-md); border-top: 1px solid var(--ds-border-default); } .belofay-faq__layout, .belofay-faq__answer { grid-template-columns: 1fr; } }
  @media (max-width: 749px) { .belofay-faq__header h2 { font-size: var(--ds-text-2xl); } .belofay-faq__header > div { font-size: var(--ds-text-md); line-height: 1.45; } .belofay-faq__list { padding: 0; border: 0; display: grid; gap: 8px; } .belofay-faq__list details, .belofay-faq__list details:last-child { border: 1px solid var(--ds-border-default); border-radius: var(--ds-radius-card); } .belofay-faq__list details[open] { margin: 0; } .belofay-faq__list summary { min-height: 72px; grid-template-columns: 48px minmax(0,1fr) 44px; padding: 10px 12px; } .belofay-faq__list summary > b { width: 48px; height: 48px; } .belofay-faq__list summary strong { font-size: 18px; } .belofay-faq__answer { padding: var(--ds-space-md); } .belofay-faq__images img { height: 120px; } .belofay-faq__help { grid-template-columns: 40px minmax(0,1fr); } .belofay-faq__help a { grid-column: 1 / -1; justify-content: center; } .belofay-faq__contact, .belofay-faq__popular { padding: var(--ds-space-md); } .belofay-faq__assurances small { font-size: var(--ds-text-xs); } }
  @keyframes belofay-faq-spin { to { transform: rotate(360deg); } }
  @media (max-width: 1024px) { .belofay-faq__shell { padding-bottom: 6px; } }
  @media (prefers-reduced-motion: reduce) { .belofay-faq *, .belofay-faq *::before, .belofay-faq *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; } }
{% endstylesheet %}

{% javascript %}
  (() => {
    const desktop = window.matchMedia('(min-width: 1025px)');
    const sync = root => root.querySelectorAll('[data-faq-outer]').forEach(item => { item.open = desktop.matches; });
    const init = root => root.querySelectorAll('[data-faq-section]').forEach(section => {
      sync(section);
      if (section.dataset.ready) return;
      section.dataset.ready = 'true';
      const textarea = section.querySelector('[data-faq-question]');
      const count = section.querySelector('[data-faq-count]');
      if (textarea && count) textarea.addEventListener('input', () => { count.textContent = `${textarea.value.length}/${textarea.maxLength}`; });
      const form = section.querySelector('form');
      const submit = section.querySelector('[data-faq-submit]');
      if (form && submit) form.addEventListener('submit', () => { if (!form.checkValidity()) return; submit.disabled = true; submit.setAttribute('aria-busy','true'); });
    });
    init(document);
    desktop.addEventListener('change', () => sync(document));
    document.addEventListener('shopify:section:load', event => init(event.target));
    document.addEventListener('click', event => { const link = event.target.closest('a[href="#faqs"]'); if (!link || desktop.matches) return; const outer = document.querySelector('#faqs [data-faq-outer]'); if (outer) outer.open = true; });
  })();
{% endjavascript %}

{% schema %}

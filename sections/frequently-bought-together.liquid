{% comment %}
  Frequently Bought Together — per-product rules set in the theme editor.
  Each block targets one product and lists suggested products. The section
  only renders on a product page whose product matches a block's target.
{% endcomment %}

{%- liquid
  assign fbt_products = blank
  for block in section.blocks
    if block.settings.target_product == product.id
      assign fbt_products = block.settings.products
      break
    endif
  endfor
-%}

{%- if fbt_products != blank and fbt_products.count > 0 -%}
<div class="fbt page-width" style="padding-top: {{ section.settings.padding_top | default: 24 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 24 }}px;">
  <h2 class="fbt__heading">{{ section.settings.heading }}</h2>
  <form class="fbt__form" data-fbt-form>
    <div class="fbt__items">
      {%- assign current_variant = product.selected_or_first_available_variant -%}
      <label class="fbt__item">
        <input type="checkbox" class="fbt__check" checked data-fbt-item data-variant-id="{{ current_variant.id }}" data-price="{{ current_variant.price }}">
        <span class="fbt__card">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 300 | image_tag: class: 'fbt__image', loading: 'lazy', widths: '150, 300' }}
          {%- endif -%}
          <span class="fbt__name">{{ product.title }}<br><em>(this item)</em></span>
          <span class="fbt__price">{{ current_variant.price | money }}</span>
        </span>
      </label>

      {%- for p in fbt_products limit: 4 -%}
        {%- if p.id != product.id -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          <span class="fbt__plus" aria-hidden="true">+</span>
          <label class="fbt__item{% unless v.available %} fbt__item--soldout{% endunless %}">
            <input type="checkbox" class="fbt__check" {% if v.available %}checked{% else %}disabled{% endif %} data-fbt-item data-variant-id="{{ v.id }}" data-price="{{ v.price }}">
            <span class="fbt__card">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 300 | image_tag: class: 'fbt__image', loading: 'lazy', widths: '150, 300' }}
              {%- endif -%}
              <span class="fbt__name"><a href="{{ p.url }}">{{ p.title }}</a></span>
              <span class="fbt__price">{% if v.available %}{{ v.price | money }}{% else %}Sold out{% endif %}</span>
            </span>
          </label>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="fbt__summary">
      <span class="fbt__total-label">Total for selected:</span>
      <strong class="fbt__total" data-fbt-total></strong>
      <button type="submit" class="fbt__add" data-fbt-add>Add selected to cart</button>
      <span class="fbt__msg" data-fbt-msg role="status"></span>
    </div>
  </form>
</div>
{%- endif -%}

{% stylesheet %}
  .fbt__heading {
    margin: 0 0 18px;
    font-size: clamp(1.7rem, 1.8vw, 2.1rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #191919;
  }

  .fbt__form {
    border: 1px solid rgb(0 0 0 / 8%);
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: #fafafa;
  }

  .fbt__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .fbt__item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    cursor: pointer;
  }

  .fbt__item--soldout {
    opacity: 0.55;
  }

  .fbt__check {
    margin-top: 6px;
    width: 16px;
    height: 16px;
    accent-color: #191919;
  }

  .fbt__card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 140px;
  }

  .fbt__image {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 8px;
    background: #fff;
    border: 1px solid rgb(0 0 0 / 6%);
  }

  .fbt__name {
    font-size: 1.15rem;
    line-height: 1.4;
    color: #191919;
  }

  .fbt__name a {
    color: inherit;
    text-decoration: none;
  }

  .fbt__name a:hover {
    text-decoration: underline;
  }

  .fbt__name em {
    color: #8a8a8a;
    font-style: normal;
    font-size: 1rem;
  }

  .fbt__price {
    font-size: 1.2rem;
    font-weight: 700;
    color: #191919;
  }

  .fbt__plus {
    font-size: 2rem;
    color: #9a9a9a;
    align-self: center;
  }

  .fbt__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    border-top: 1px solid rgb(0 0 0 / 8%);
    padding-top: 14px;
  }

  .fbt__total-label {
    font-size: 1.2rem;
    color: #4a4a4a;
  }

  .fbt__total {
    font-size: 1.5rem;
    color: #191919;
  }

  .fbt__add {
    padding: 12px 22px;
    background: #191919;
    color: #fff;
    border: none;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .fbt__add:hover {
    opacity: 0.85;
  }

  .fbt__add[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  .fbt__msg {
    font-size: 1.15rem;
    color: #1a7a3a;
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-fbt-form]').forEach(function (form) {
    var totalEl = form.querySelector('[data-fbt-total]');
    var msgEl = form.querySelector('[data-fbt-msg]');
    var addBtn = form.querySelector('[data-fbt-add]');
    var items = Array.prototype.slice.call(form.querySelectorAll('[data-fbt-item]'));
    var currency = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'GBP';
    var fmt = function (cents) {
      try {
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency }).format(cents / 100);
      } catch (e) {
        return '£' + (cents / 100).toFixed(2);
      }
    };
    var update = function () {
      var total = 0;
      var any = false;
      items.forEach(function (cb) {
        if (cb.checked && !cb.disabled) {
          total += parseInt(cb.dataset.price, 10) || 0;
          any = true;
        }
      });
      if (totalEl) totalEl.textContent = fmt(total);
      if (addBtn) addBtn.disabled = !any;
    };
    items.forEach(function (cb) { cb.addEventListener('change', update); });
    update();

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var lines = items
        .filter(function (cb) { return cb.checked && !cb.disabled; })
        .map(function (cb) { return { id: parseInt(cb.dataset.variantId, 10), quantity: 1 }; });
      if (!lines.length) return;
      addBtn.disabled = true;
      msgEl.textContent = 'Adding\u2026';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: lines })
      })
        .then(function (r) {
          if (!r.ok) return r.json().then(function (d) { throw new Error(d.description || 'Could not add to cart'); });
          return r.json();
        })
        .then(function () {
          msgEl.textContent = 'Added! Redirecting to cart\u2026';
          window.location.href = '/cart';
        })
        .catch(function (err) {
          msgEl.textContent = err.message;
          msgEl.style.color = '#b3261e';
          addBtn.disabled = false;
        });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Bought together",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Bought Together" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "rule",
      "name": "Product rule",
      "settings": [
        { "type": "product", "id": "target_product", "label": "Show on this product" },
        { "type": "product_list", "id": "products", "label": "Suggested products", "limit": 4 }
      ]
    }
  ],
  "presets": [{ "name": "Bought together" }]
}
{% endschema %}

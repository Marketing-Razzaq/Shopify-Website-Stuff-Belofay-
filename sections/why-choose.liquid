{% comment %}
  Why Choose — trust bar with heading and icon items on a soft background.
{% endcomment %}

<div class="wcb" style="--wcb-bg: {{ section.settings.background_color | default: '#f4f2ee' }};">
  <div class="wcb__inner page-width" style="padding-top: {{ section.settings.padding_top | default: 32 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 32 }}px;">
    <h2 class="wcb__heading">{{ section.settings.heading }}</h2>
    <div class="wcb__items">
      {%- for block in section.blocks -%}
        <div class="wcb__item" {{ block.shopify_attributes }}>
          <span class="wcb__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="5" width="14" height="12"/><path d="M15 9h4l3 3v5h-7"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg>
              {%- when 'clock' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg>
              {%- when 'lock' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15" r="1.3"/></svg>
              {%- when 'badge' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M9 14.5L7 22l5-3 5 3-2-7.5"/><path d="M9.8 9l1.6 1.6L14.6 7.4"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13a8 8 0 0 1 16 0"/><rect x="2" y="13" width="4" height="7" rx="2"/><rect x="18" y="13" width="4" height="7" rx="2"/><path d="M20 20a4 4 0 0 1-4 2h-2"/></svg>
            {%- endcase -%}
          </span>
          <span class="wcb__copy">
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.subtitle }}</span>
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .wcb {
    background: var(--wcb-bg, #f4f2ee);
    margin: 24px 0;
  }

  .wcb__inner {
    padding-top: 34px;
    padding-bottom: 34px;
  }

  .wcb__heading {
    margin: 0 0 24px;
    text-align: center;
    font-size: clamp(1.9rem, 2vw, 2.4rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #191919;
  }

  .wcb__items {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 18px 26px;
  }

  .wcb__item {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1 1 170px;
    color: #8a7a5c;
  }

  .wcb__icon {
    display: inline-flex;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }

  .wcb__copy {
    display: flex;
    flex-direction: column;
    font-size: 1.15rem;
    color: #4a4a4a;
  }

  .wcb__copy strong {
    color: #191919;
    font-size: 1.2rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why choose bar",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose Belofay?" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#F4F2EE" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery truck" },
            { "value": "clock", "label": "Clock" },
            { "value": "lock", "label": "Padlock" },
            { "value": "badge", "label": "Award badge" },
            { "value": "headset", "label": "Headset" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free UK Delivery" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "On all orders" }
      ]
    }
  ],
  "presets": [{ "name": "Why choose bar" }]
}
{% endschema %}

<section id="belofay-delivery" class="belofay-pdp__section" style="background:var(--ds-bg-surface)">
  <div class="belofay-pdp__shell"><p class="belofay-pdp__eyebrow">{{ section.settings.eyebrow }}</p><h2 class="belofay-pdp__heading">{{ section.settings.heading }}</h2><p class="belofay-pdp__lede">{{ section.settings.text }}</p>
    <div class="belofay-pdp__grid belofay-pdp__grid--4" style="margin-top:var(--ds-space-xl)">{%- for block in section.blocks -%}<article class="belofay-pdp__card belofay-pdp__feature" {{ block.shopify_attributes }}>{% render 'belofay-pdp-icon', name: block.settings.icon %}<h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{%- endfor -%}</div>
    <div class="belofay-pdp__grid belofay-pdp__grid--2" style="margin-top:var(--ds-space-lg)"><article class="belofay-pdp__card belofay-pdp__feature"><h3>{{ section.settings.journey_heading }}</h3><div class="belofay-pdp-timeline"><article class="belofay-pdp-timeline__step">Order confirmed</article><article class="belofay-pdp-timeline__step">Dispatched</article><article class="belofay-pdp-timeline__step">Tracking sent</article><article class="belofay-pdp-timeline__step">Delivered</article></div></article><article class="belofay-pdp__card belofay-pdp__notice"><h3>{{ section.settings.returns_heading }}</h3><p>{{ section.settings.returns_text }}</p><ul class="belofay-pdp__check-list"><li><span class="belofay-pdp__check">✓</span>Unused and in original packaging</li><li><span class="belofay-pdp__check">✓</span>Refund processed after receipt</li></ul></article></div>
    <div style="margin-top:var(--ds-space-md)"><details class="belofay-pdp__accordion"><summary>Delivery details</summary><div class="belofay-pdp__accordion-content">{{ section.settings.delivery_details }}</div></details><details class="belofay-pdp__accordion"><summary>Returns & refunds</summary><div class="belofay-pdp__accordion-content">{{ section.settings.return_details }}</div></details><details class="belofay-pdp__accordion"><summary>Damaged or missing items</summary><div class="belofay-pdp__accordion-content">{{ section.settings.damage_details }}</div></details></div>
  </div>
</section>
{% schema %}
{"name":"Belofay PDP delivery","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"DELIVERY & RETURNS"},{"type":"text","id":"heading","label":"Heading","default":"Delivery & Returns"},{"type":"textarea","id":"text","label":"Introduction","default":"Know what to expect before your order arrives."},{"type":"text","id":"journey_heading","label":"Journey heading","default":"Your delivery"},{"type":"text","id":"returns_heading","label":"Returns heading","default":"Changed your mind?"},{"type":"textarea","id":"returns_text","label":"Returns text","default":"You can return this item within 30 days, subject to the returns policy."},{"type":"textarea","id":"delivery_details","label":"Delivery details","default":"Tracking details are sent after dispatch. Large items may arrive in separate parcels."},{"type":"textarea","id":"return_details","label":"Return details","default":"Items must be unused and in their original packaging."},{"type":"textarea","id":"damage_details","label":"Damage details","default":"Photograph the packaging and item, then contact the support team promptly."}],"blocks":[{"type":"promise","name":"Delivery promise","limit":4,"settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"delivery","label":"Delivery"},{"value":"shield","label":"Shield"},{"value":"check","label":"Check"}],"default":"delivery"},{"type":"text","id":"heading","label":"Heading","default":"Free UK Delivery"},{"type":"text","id":"text","label":"Text","default":"No standard delivery charge on this product."}]}],"presets":[{"name":"Belofay PDP delivery","blocks":[{"type":"promise"},{"type":"promise"},{"type":"promise"},{"type":"promise"}]}]}
{% endschema %}

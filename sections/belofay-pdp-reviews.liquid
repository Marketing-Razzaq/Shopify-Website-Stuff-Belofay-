<section id="belofay-reviews" class="belofay-pdp__section">
  <div class="belofay-pdp__shell"><p class="belofay-pdp__eyebrow">{{ section.settings.eyebrow }}</p><h2 class="belofay-pdp__heading">{{ section.settings.heading }}</h2><p class="belofay-pdp__lede">{{ section.settings.text }}</p>
    <div class="belofay-pdp__card belofay-pdp-review-summary" style="margin-top:var(--ds-space-xl)"><div><div class="belofay-pdp-review-summary__score">{{ section.settings.rating }}</div><div class="belofay-pdp-rating__stars" aria-hidden="true">★★★★★</div><p>{{ section.settings.count }} ratings</p></div><div class="belofay-pdp-review-bars"><div class="belofay-pdp-review-bar"><span>5 ★</span><span><i style="width:78%"></i></span><span>78%</span></div><div class="belofay-pdp-review-bar"><span>4 ★</span><span><i style="width:15%"></i></span><span>15%</span></div><div class="belofay-pdp-review-bar"><span>3 ★</span><span><i style="width:5%"></i></span><span>5%</span></div><div class="belofay-pdp-review-bar"><span>2 ★</span><span><i style="width:1%"></i></span><span>1%</span></div><div class="belofay-pdp-review-bar"><span>1 ★</span><span><i style="width:1%"></i></span><span>1%</span></div></div></div>
    <div class="belofay-pdp__grid belofay-pdp__grid--3" style="margin-top:var(--ds-space-lg)">{%- for block in section.blocks -%}<article class="belofay-pdp__card belofay-pdp__feature" {{ block.shopify_attributes }}><div class="belofay-pdp-rating__stars" aria-hidden="true">★★★★★</div><p>“{{ block.settings.quote }}”</p><strong>{{ block.settings.author }}</strong><p style="color:var(--ds-action-primary-hover)">✓ Verified purchase</p></article>{%- endfor -%}</div>
  </div>
</section>
{% schema %}
{"name":"Belofay PDP reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"VERIFIED REVIEWS"},{"type":"text","id":"heading","label":"Heading","default":"What customers say"},{"type":"textarea","id":"text","label":"Introduction","default":"Clear, readable feedback from verified customers."},{"type":"text","id":"rating","label":"Rating","default":"4.5"},{"type":"number","id":"count","label":"Rating count","default":121}],"blocks":[{"type":"review","name":"Review","limit":6,"settings":[{"type":"textarea","id":"quote","label":"Review","default":"Great quality unit, looks fantastic and was straightforward to assemble."},{"type":"text","id":"author","label":"Author","default":"Sarah K."}]}],"presets":[{"name":"Belofay PDP reviews","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}
{% endschema %}

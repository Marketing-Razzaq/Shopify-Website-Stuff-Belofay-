<section id="belofay-dimensions" class="belofay-pdp__section" style="background:var(--ds-bg-surface)">
  <div class="belofay-pdp__shell">
    <p class="belofay-pdp__eyebrow">{{ section.settings.eyebrow }}</p><h2 class="belofay-pdp__heading">{{ section.settings.heading }}</h2><p class="belofay-pdp__lede">{{ section.settings.text }}</p>
    <div class="belofay-pdp__grid belofay-pdp__grid--3" style="margin-top:var(--ds-space-xl)">
      <article class="belofay-pdp__card belofay-pdp__feature">
        <h3>{{ section.settings.overall_heading }}</h3>
        {%- if section.settings.diagram != blank -%}{{ section.settings.diagram | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900' }}{%- else -%}<div class="belofay-pdp__media-placeholder">{{ 'product-2' | placeholder_svg_tag }}</div>{%- endif -%}
      </article>
      <article class="belofay-pdp__card belofay-pdp__feature"><h3>{{ section.settings.scale_heading }}</h3>{%- if section.settings.scale_image != blank -%}{{ section.settings.scale_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900' }}{%- else -%}<div class="belofay-pdp__media-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>{%- endif -%}</article>
      <article class="belofay-pdp__card belofay-pdp__feature"><h3>{{ section.settings.measurements_heading }}</h3><table class="belofay-pdp-spec-table"><tbody><tr><th>Overall width</th><td>{{ section.settings.width }}</td></tr><tr><th>Overall depth</th><td>{{ section.settings.depth }}</td></tr><tr><th>Overall height</th><td>{{ section.settings.height }}</td></tr><tr><th>Basin material</th><td>{{ section.settings.basin }}</td></tr><tr><th>Doors</th><td>{{ section.settings.doors }}</td></tr></tbody></table></article>
    </div>
    <div class="belofay-pdp__grid belofay-pdp__grid--2" style="margin-top:var(--ds-space-md)"><details class="belofay-pdp__card belofay-pdp__feature"><summary>Space you’ll need</summary><p>{{ section.settings.space_text }}</p></details><details class="belofay-pdp__card belofay-pdp__feature"><summary>Installation details</summary><p>{{ section.settings.install_text }}</p></details></div>
  </div>
</section>
{% schema %}
{"name":"Belofay PDP dimensions","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BELOFAY"},{"type":"text","id":"heading","label":"Heading","default":"Dimensions & Fit"},{"type":"textarea","id":"text","label":"Introduction","default":"Check the measurements and key fit information before ordering."},{"type":"text","id":"overall_heading","label":"Diagram heading","default":"Overall dimensions"},{"type":"image_picker","id":"diagram","label":"Dimension diagram"},{"type":"text","id":"scale_heading","label":"Scale heading","default":"In-room scale"},{"type":"image_picker","id":"scale_image","label":"In-room image"},{"type":"text","id":"measurements_heading","label":"Measurements heading","default":"Key measurements"},{"type":"text","id":"width","label":"Width","default":"600mm"},{"type":"text","id":"depth","label":"Depth","default":"388mm"},{"type":"text","id":"height","label":"Height","default":"800mm"},{"type":"text","id":"basin","label":"Basin material","default":"Ceramic"},{"type":"text","id":"doors","label":"Doors","default":"2 soft-close doors"},{"type":"textarea","id":"space_text","label":"Space text","default":"Allow clearance for doors, pipework and comfortable use."},{"type":"textarea","id":"install_text","label":"Installation text","default":"Measurements are approximate. Confirm site dimensions before installation."}],"presets":[{"name":"Belofay PDP dimensions"}]}
{% endschema %}

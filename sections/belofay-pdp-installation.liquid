<section id="belofay-installation" class="belofay-pdp__section">
  <div class="belofay-pdp__shell">
    <p class="belofay-pdp__eyebrow">{{ section.settings.eyebrow }}</p><h2 class="belofay-pdp__heading">{{ section.settings.heading }}</h2><p class="belofay-pdp__lede">{{ section.settings.text }}</p>
    <div class="belofay-pdp__grid belofay-pdp__grid--4" style="margin-top:var(--ds-space-xl)">{%- for block in section.blocks -%}<article class="belofay-pdp__card belofay-pdp__feature" {{ block.shopify_attributes }}>{% render 'belofay-pdp-icon', name: block.settings.icon %}<h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{%- endfor -%}</div>
    <div class="belofay-pdp__grid belofay-pdp__grid--2" style="margin-top:var(--ds-space-lg)">
      <article class="belofay-pdp__card belofay-pdp__feature"><h3>{{ section.settings.plumbing_heading }}</h3>{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200' }}{%- else -%}<div class="belofay-pdp__media-placeholder">{{ 'product-3' | placeholder_svg_tag }}</div>{%- endif -%}</article>
      <div><h3>{{ section.settings.steps_heading }}</h3><div class="belofay-pdp-timeline">{%- assign steps = section.settings.steps | newline_to_br | split: '<br />' -%}{%- for step in steps -%}<article class="belofay-pdp__card belofay-pdp-timeline__step">{{ step }}</article>{%- endfor -%}</div></div>
    </div>
    <div class="belofay-pdp__grid belofay-pdp__grid--2" style="margin-top:var(--ds-space-md)"><details class="belofay-pdp__card belofay-pdp__feature"><summary>Included parts & fittings</summary><p>{{ section.settings.parts }}</p></details><details class="belofay-pdp__card belofay-pdp__feature"><summary>Expert installation notes</summary><p>{{ section.settings.notes }}</p></details></div>
  </div>
</section>
{% schema %}
{"name":"Belofay PDP installation","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BELOFAY"},{"type":"text","id":"heading","label":"Heading","default":"Installation"},{"type":"textarea","id":"text","label":"Introduction","default":"Everything you need to fit your vanity unit with confidence."},{"type":"text","id":"plumbing_heading","label":"Plumbing heading","default":"Plan your plumbing space"},{"type":"image_picker","id":"image","label":"Installation image"},{"type":"text","id":"steps_heading","label":"Steps heading","default":"How installation works"},{"type":"textarea","id":"steps","label":"Installation steps, one per line","default":"Assemble cabinet\nPosition and level\nFit tap and waste\nSeat and seal basin\nConnect and test"},{"type":"textarea","id":"parts","label":"Parts text","default":"Cabinet, basin, chrome waste, hinges, handles and assembly instructions."},{"type":"textarea","id":"notes","label":"Expert notes","default":"Use a qualified installer for water and waste connections."}],"blocks":[{"type":"item","name":"Installation fact","limit":4,"settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"tools","label":"Tools"},{"value":"check","label":"Check"},{"value":"shield","label":"Shield"}],"default":"tools"},{"type":"text","id":"heading","label":"Heading","default":"Assembly required"},{"type":"text","id":"text","label":"Text","default":"Simple assembly with clear instructions."}]}],"presets":[{"name":"Belofay PDP installation","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]}
{% endschema %}

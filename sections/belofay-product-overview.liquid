<section id="overview" class="belofay-overview" style="--overview-green: var(--ds-action-primary); --overview-orange: var(--ds-action-attention); --overview-text: var(--ds-text-heading); --overview-muted: var(--ds-text-supporting);">
  <div class="belofay-overview__shell">
    <details class="belofay-overview__accordion" open>
      <summary><span><strong>{{ section.settings.accordion_label }}</strong><small>{{ section.settings.accordion_summary }}</small></span><span class="belofay-overview__chevron" aria-hidden="true"></span></summary>
      <div class="belofay-overview__content">
        <div class="belofay-overview__intro">
          <div class="belofay-overview__copy">
            {%- if section.settings.eyebrow != blank -%}<p class="belofay-overview__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
            <h2>{{ section.settings.heading }}</h2>
            <div class="belofay-overview__description">{{ section.settings.description }}</div>
          </div>
          <div class="belofay-overview__features">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <article class="belofay-overview__feature{% if block.settings.wide %} belofay-overview__feature--wide{% endif %}" {{ block.shopify_attributes }}>
                  {% render 'belofay-overview-icon', name: block.settings.icon %}
                  <h3>{{ block.settings.heading }}</h3>
                  <p>{{ block.settings.text }}</p>
                  {%- if block.settings.note != blank -%}<small>{{ block.settings.note }}</small>{%- endif -%}
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <div class="belofay-overview__grid">
          <figure class="belofay-overview__main-visual">
            <div class="belofay-overview__image belofay-overview__image--main">
              {%- assign main_image = section.settings.main_image | default: product.featured_image -%}
              {%- if main_image != blank -%}
                {{ main_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 40vw, 100vw', alt: section.settings.main_image_alt }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
              <span class="belofay-overview__image-label">{{ section.settings.main_image_label }}</span>
            </div>
            <figcaption><strong>{{ section.settings.main_caption_heading }}</strong><span>{{ section.settings.main_caption_text }}</span></figcaption>
          </figure>

          <figure class="belofay-overview__storage">
            <div class="belofay-overview__image belofay-overview__image--storage">
              {%- assign storage_image = section.settings.storage_image | default: product.media[1].preview_image -%}
              {%- if storage_image != blank -%}
                {{ storage_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 18vw, 55vw', alt: section.settings.storage_image_alt }}
              {%- else -%}
                {{ 'product-2' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <figcaption><strong>{{ section.settings.storage_heading }}</strong><span>{{ section.settings.storage_text }}</span></figcaption>
          </figure>

          <div class="belofay-overview__cards">
            <article class="belofay-overview__card belofay-overview__card--included">
              <h3>{{ section.settings.included_heading }}</h3>
              <ul>
                {%- for block in section.blocks -%}{%- if block.type == 'included_item' -%}<li {{ block.shopify_attributes }}><span class="belofay-overview__status">{% render 'belofay-overview-icon', name: 'check' %}</span>{% render 'belofay-overview-icon', name: block.settings.icon %}<span>{{ block.settings.text }}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
            </article>

            <article class="belofay-overview__card belofay-overview__card--warning">
              <h3>{{ section.settings.warning_heading }}</h3>
              <ul>
                {%- for block in section.blocks -%}{%- if block.type == 'notice' -%}<li {{ block.shopify_attributes }}><span class="belofay-overview__status{% if block.settings.tone == 'warning' %} belofay-overview__status--warning{% else %} belofay-overview__status--info{% endif %}">{% render 'belofay-overview-icon', name: block.settings.tone %}</span><span><strong>{{ block.settings.heading }}</strong><small>{{ block.settings.text }}</small>{% if block.settings.link != blank and block.settings.link_label != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label }} <span aria-hidden="true">→</span></a>{% endif %}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
            </article>

            <details class="belofay-overview__card belofay-overview__materials" open>
              <summary>{% render 'belofay-overview-icon', name: 'materials' %}<span><strong>{{ section.settings.materials_heading }}</strong><small>{{ section.settings.materials_mobile_summary }}</small></span><span class="belofay-overview__chevron" aria-hidden="true"></span></summary>
              <ul>
                {%- for block in section.blocks -%}{%- if block.type == 'material' -%}<li {{ block.shopify_attributes }}><span class="belofay-overview__status">{% render 'belofay-overview-icon', name: 'check' %}</span>{{ block.settings.text }}</li>{%- endif -%}{%- endfor -%}
              </ul>
            </details>

            <article class="belofay-overview__card belofay-overview__reviews" id="reviews">
              <div class="belofay-overview__reviews-head"><h3>{{ section.settings.reviews_heading }}</h3><span class="belofay-overview__verified"><span class="belofay-overview__status">{% render 'belofay-overview-icon', name: 'check' %}</span>{{ section.settings.verified_label }}</span></div>
              <div class="belofay-overview__review-grid">
                <div><strong class="belofay-overview__rating">{{ section.settings.rating }}</strong><span class="belofay-overview__stars" aria-label="{{ section.settings.rating }} out of 5">★★★★★</span><span>{{ section.settings.rating_count }} ratings</span></div>
                <div class="belofay-overview__bars" aria-label="Rating distribution">
                  {%- for block in section.blocks -%}{%- if block.type == 'rating_bar' -%}<div {{ block.shopify_attributes }}><span>{{ block.settings.stars }} ★</span><i><b style="width: {{ block.settings.percent }}%"></b></i><span>{{ block.settings.percent }}%</span></div>{%- endif -%}{%- endfor -%}
                </div>
              </div>
              <blockquote>“{{ section.settings.review_quote }}”<footer>— {{ section.settings.review_author }} <span class="belofay-overview__verified"><span class="belofay-overview__status">{% render 'belofay-overview-icon', name: 'check' %}</span>{{ section.settings.verified_purchase }}</span></footer></blockquote>
              <a class="belofay-overview__all-reviews" href="{{ section.settings.all_reviews_link | default: '#reviews' }}">{{ section.settings.all_reviews_label }} <span aria-hidden="true">→</span></a>
            </article>
          </div>
        </div>
      </div>
    </details>
  </div>
</section>

{% stylesheet %}
  .belofay-overview { color: var(--overview-text); font-family: var(--pdp-font-family, Arial, sans-serif); background: var(--ds-bg-page); }
  .belofay-overview *, .belofay-overview *::before, .belofay-overview *::after { box-sizing: border-box; }
  .belofay-overview__tabs { position: sticky; top: var(--header-height, 0px); z-index: 20; background: var(--ds-overlay-white-96); border-bottom: 1px solid var(--ds-border-default); backdrop-filter: blur(12px); }
  .belofay-overview__tabs-inner { max-width: 1600px; margin: 0 auto; padding: 0 32px; display: flex; gap: clamp(32px, 5vw, 80px); overflow-x: auto; scrollbar-width: none; }
  .belofay-overview__tabs-inner::-webkit-scrollbar { display: none; }
  .belofay-overview__tabs a { position: relative; flex: 0 0 auto; padding: 18px 10px 16px; color: var(--overview-muted); text-decoration: none; font-size: 17px; line-height: 1; white-space: nowrap; }
  .belofay-overview__tabs a:hover, .belofay-overview__tabs a:focus-visible, .belofay-overview__tabs a.is-active { color: var(--overview-green); }
  .belofay-overview__tabs a.is-active::after { content: ''; position: absolute; right: 0; bottom: -1px; left: 0; height: 3px; border-radius: 3px 3px 0 0; background: var(--overview-green); }
  .belofay-overview__tabs a:focus-visible { outline: 2px solid var(--overview-green); outline-offset: -2px; }
  .belofay-overview__shell { max-width: 1600px; margin: 0 auto; padding: 32px; }
  .belofay-overview__accordion > summary { display: none; }
  .belofay-overview__intro { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(600px, .95fr); gap: 46px; align-items: center; margin-bottom: 26px; }
  .belofay-overview__copy h2 { margin: 0 0 10px; color: var(--ds-text-heading); font-family: var(--ds-font-heading),Arial,sans-serif; font-size: clamp(30px, 2.25vw, 42px); font-weight: var(--ds-section-heading-weight, 300); line-height: 1.08; letter-spacing: -.03em; }
  .belofay-overview__eyebrow { margin: 0 0 8px; color: var(--ds-text-heading); font-family: Gilroy, Arial, sans-serif; font-size: 13px; font-weight: 400; letter-spacing: .25em; text-transform: uppercase; }
  .belofay-overview__description { max-width: 820px; color: var(--ds-text-supporting); font-family: var(--ds-font-body),Arial,sans-serif; font-size: 19px; font-weight: var(--ds-weight-regular, 400); line-height: 1.45; }
  .belofay-overview__description p { margin: 0; }
  .belofay-overview__features { display: grid; grid-template-columns: .8fr 1.6fr 1.1fr; gap: 12px; }
  .belofay-overview__feature { min-height: 174px; padding: 20px 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; border-radius: 12px; background: linear-gradient(135deg, var(--ds-bg-success), var(--ds-bg-success)); }
  .belofay-overview__feature > svg { width: 54px; height: 54px; margin-bottom: 10px; fill: none; stroke: var(--ds-text-heading); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .belofay-overview__feature h3 { margin: 0 0 6px; color: var(--ds-text-heading); font-size: 20px; line-height: 1.15; }
  .belofay-overview__feature p, .belofay-overview__feature small { margin: 0; color: var(--overview-muted); font-size: 16px; line-height: 1.35; }
  .belofay-overview__grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(240px, .7fr) minmax(500px, 1.55fr); gap: 16px; align-items: start; }
  .belofay-overview figure { margin: 0; }
  .belofay-overview__image { position: relative; overflow: hidden; border-radius: 10px; background: var(--ds-bg-success); }
  .belofay-overview__image img, .belofay-overview__image .placeholder-svg { width: 100%; height: 100%; display: block; object-fit: cover; }
  .belofay-overview__image--main { aspect-ratio: 1.12 / 1; }
  .belofay-overview__image--storage { aspect-ratio: .86 / 1; }
  .belofay-overview__image-label { position: absolute; top: 16px; left: 16px; max-width: calc(100% - 32px); padding: 10px 14px; border-radius: 9px; background: var(--ds-overlay-white-90); color: var(--ds-text-heading); font-weight: 700; font-size: 16px; backdrop-filter: blur(8px); }
  .belofay-overview figcaption { display: flex; flex-direction: column; padding: 10px 6px 0; color: var(--overview-muted); font-size: 15px; line-height: 1.35; }
  .belofay-overview figcaption strong { color: var(--ds-text-heading); font-size: 18px; }
  .belofay-overview__cards { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 14px; align-items: start; }
  .belofay-overview__card { min-width: 0; padding: 22px 24px; border: 1px solid var(--ds-border-default); border-radius: 10px; background: var(--ds-bg-page); }
  .belofay-overview__card--included { background: linear-gradient(135deg, var(--ds-bg-success), var(--ds-bg-page)); }
  .belofay-overview__card--warning { border-color: var(--ds-border-attention-soft); background: linear-gradient(135deg, var(--ds-bg-page), var(--ds-bg-attention)); }
  .belofay-overview__card h3 { margin: 0 0 16px; color: var(--ds-text-heading); font-size: 21px; line-height: 1.15; }
  .belofay-overview__card ul { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .belofay-overview__card li { display: flex; align-items: center; gap: 12px; color: var(--overview-muted); font-size: 15px; line-height: 1.3; }
  .belofay-overview__card li > svg { width: 32px; height: 32px; flex: 0 0 32px; fill: none; stroke: var(--ds-text-heading); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .belofay-overview__card li strong, .belofay-overview__card li small { display: block; }
  .belofay-overview__card li strong { color: var(--ds-text-heading); font-size: 16px; }
  .belofay-overview__card li small { color: var(--overview-muted); font-size: 14px; }
  .belofay-overview__card li a { color: var(--overview-orange); text-underline-offset: 2px; }
  .belofay-overview__status { width: 25px; height: 25px; flex: 0 0 25px; display: inline-grid; place-items: center; border-radius: 50%; color: var(--ds-text-on-primary); background: var(--overview-green); }
  .belofay-overview__status svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .belofay-overview__status--warning { background: var(--overview-orange); }
  .belofay-overview__status--info { background: var(--ds-text-supporting); }
  .belofay-overview__materials summary { display: flex; align-items: center; gap: 12px; list-style: none; }
  .belofay-overview__materials summary::-webkit-details-marker { display: none; }
  .belofay-overview__materials summary > svg { width: 34px; height: 34px; flex: 0 0 34px; fill: none; stroke: var(--ds-text-heading); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .belofay-overview__materials summary strong { display: block; color: var(--ds-text-heading); font-size: 17px; }
  .belofay-overview__materials summary small, .belofay-overview__materials .belofay-overview__chevron { display: none; }
  .belofay-overview__materials ul { margin-top: 20px; }
  .belofay-overview__reviews-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; align-items: center; }
  .belofay-overview__reviews-head h3 { min-width: 0; margin: 0; overflow-wrap: normal; word-break: normal; }
  .belofay-overview__verified { display: inline-flex; align-items: center; gap: 6px; color: var(--ds-action-primary); font-size: 12px; white-space: nowrap; }
  .belofay-overview__verified .belofay-overview__status { width: 20px; height: 20px; flex-basis: 20px; }
  .belofay-overview__reviews { min-width: 0; overflow: hidden; }
  .belofay-overview__reviews h3 { font-size: 18px; }
  .belofay-overview__review-grid { min-width: 0; display: grid; grid-template-columns: 1fr; gap: 14px; align-items: center; }
  .belofay-overview__review-grid > div:first-child { display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 10px; }
  .belofay-overview__rating { grid-row: 1 / 3; color: var(--ds-text-heading); font-size: 48px; line-height: 1; }
  .belofay-overview__stars { color: var(--overview-orange); font-size: 21px; letter-spacing: 1px; }
  .belofay-overview__bars { min-width: 0; display: grid; gap: 5px; }
  .belofay-overview__bars > div { min-width: 0; display: grid; grid-template-columns: 36px minmax(24px, 1fr) 30px; gap: 6px; align-items: center; color: var(--overview-muted); font-size: 12px; }
  .belofay-overview__bars i { height: 8px; overflow: hidden; border-radius: 10px; background: var(--ds-bg-success); }
  .belofay-overview__bars b { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--ds-action-primary), var(--ds-action-primary)); }
  .belofay-overview__reviews blockquote { margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--ds-border-default); color: var(--overview-muted); font-size: 14px; font-style: italic; }
  .belofay-overview__reviews blockquote footer { display: flex; justify-content: space-between; gap: 8px; margin-top: 8px; font-style: normal; }
  .belofay-overview__all-reviews { display: none; }

  @media (max-width: 1599px) {
    .belofay-overview__intro { grid-template-columns: 1fr; gap: 24px; }
    .belofay-overview__grid { grid-template-columns: 1.4fr .8fr; }
    .belofay-overview__cards { grid-column: 1 / -1; }
  }

  @media (max-width: 1024px) {
    .belofay-overview__tabs { top: var(--header-height, 0px); }
    .belofay-overview__tabs-inner { padding: 0 18px; gap: 28px; }
    .belofay-overview__tabs a { padding: 15px 0 13px; font-size: 14px; }
    .belofay-overview__shell { padding: 12px 16px 6px; }
    .belofay-overview__accordion { overflow: clip; border: 1px solid var(--ds-control-border, var(--ds-border-default)); border-radius: var(--ds-radius-card, 10px); background: var(--ds-bg-page); transition: border-color var(--motion-duration-base, 240ms) var(--motion-ease-standard, ease), background-color var(--motion-duration-base, 240ms) var(--motion-ease-standard, ease); }
    .belofay-overview__accordion[open] { border-color: color-mix(in srgb,var(--ds-action-primary, var(--overview-green)),var(--ds-border-default) 55%); background: color-mix(in srgb,var(--ds-bg-surface, var(--ds-bg-page)),var(--ds-bg-page) 65%); }
    .belofay-overview__accordion > summary { min-height: 64px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; list-style: none; color: var(--ds-text-heading); transition: color var(--motion-duration-fast, 160ms) var(--motion-ease-standard, ease), background-color var(--motion-duration-fast, 160ms) var(--motion-ease-standard, ease), transform var(--motion-duration-fast, 160ms) var(--motion-ease-standard, ease); }
    .belofay-overview__accordion > summary > span:first-child { display: grid; }
    .belofay-overview__accordion > summary strong { color: var(--ds-text-heading); font-family: var(--ds-font-heading),Arial,sans-serif; font-size: 19px; font-weight: var(--ds-weight-semibold, 600); line-height: 1.2; }
    .belofay-overview__accordion > summary small { margin-top: 2px; color: var(--ds-text-supporting); font-family: var(--ds-font-body),Arial,sans-serif; font-size: var(--ds-text-sm, 14px); font-weight: var(--ds-weight-regular, 400); line-height: 1.25; }
    .belofay-overview__accordion > summary:hover { color: var(--ds-action-primary-hover, var(--overview-green)); background: var(--ds-control-selected-bg, var(--ds-bg-success)); }
    .belofay-overview__accordion > summary:active { transform: scale(var(--motion-press-scale, .99)); }
    .belofay-overview__accordion > summary::-webkit-details-marker { display: none; }
    .belofay-overview__chevron { width: 10px; height: 10px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); transition: transform .2s ease; }
    .belofay-overview__accordion[open] > summary .belofay-overview__chevron, .belofay-overview__materials[open] .belofay-overview__chevron { transform: rotate(225deg); }
    .belofay-overview__content { padding: 20px 14px 14px; border-top: 1px solid var(--ds-border-default); }
    .belofay-overview__intro { display: contents; }
    .belofay-overview__copy { margin-bottom: 16px; }
    .belofay-overview__eyebrow { display: block; }
    .belofay-overview__copy h2 { font-size: 30px; }
    .belofay-overview__description { font-size: 17px; line-height: 1.42; }
    .belofay-overview__features { grid-template-columns: repeat(3, minmax(0,1fr)); gap: 8px; margin-bottom: 16px; }
    .belofay-overview__feature { min-height: 154px; padding: 14px 10px; align-items: flex-start; justify-content: flex-start; text-align: left; }
    .belofay-overview__feature > svg { width: 35px; height: 35px; margin-bottom: 12px; stroke: var(--overview-green); }
    .belofay-overview__feature h3 { font-size: 16px; }
    .belofay-overview__feature p, .belofay-overview__feature small { font-size: 14px; }
    .belofay-overview__feature--wide { order: -1; }
    .belofay-overview__feature--wide small { display: none; }
    .belofay-overview__grid { display: flex; flex-direction: column; gap: 12px; }
    .belofay-overview__main-visual, .belofay-overview__storage, .belofay-overview__cards { width: 100%; }
    .belofay-overview__image--main { aspect-ratio: 1.7 / 1; }
    .belofay-overview__image-label { top: auto; right: auto; bottom: 12px; left: 12px; padding: 8px 10px; color: var(--ds-text-on-primary); background: var(--ds-overlay-dark-78); font-size: 13px; }
    .belofay-overview__main-visual figcaption { display: none; }
    .belofay-overview__storage { display: grid; grid-template-columns: .95fr 1.15fr; min-height: 180px; overflow: hidden; border-radius: 10px; background: linear-gradient(90deg, var(--ds-bg-page), var(--ds-bg-success)); }
    .belofay-overview__storage .belofay-overview__image { grid-column: 2; grid-row: 1; border-radius: 0; aspect-ratio: auto; }
    .belofay-overview__storage figcaption { grid-column: 1; grid-row: 1; justify-content: center; padding: 20px; }
    .belofay-overview__storage figcaption strong { margin-bottom: 8px; font-size: 22px; line-height: 1.05; }
    .belofay-overview__cards { display: flex; flex-direction: column; gap: 10px; align-items: stretch; }
    .belofay-overview__card { padding: 18px; }
    .belofay-overview__card h3 { font-size: 21px; }
    .belofay-overview__card--included { position: relative; overflow: hidden; }
    .belofay-overview__card li { font-size: 15px; }
    .belofay-overview__card--included li > svg { display: none; }
    .belofay-overview__materials { order: 3; padding: 14px 18px; }
    .belofay-overview__materials summary { cursor: pointer; }
    .belofay-overview__materials summary small { display: block; margin-top: 3px; color: var(--overview-muted); font-weight: 400; font-size: 12px; }
    .belofay-overview__materials summary .belofay-overview__chevron { display: block; margin-left: auto; }
    .belofay-overview__materials:not([open]) ul { display: none; }
    .belofay-overview__reviews { order: 4; }
    .belofay-overview__review-grid { grid-template-columns: 1fr; }
    .belofay-overview__rating { font-size: 52px; }
    .belofay-overview__reviews blockquote { padding: 14px; border: 0; border-radius: 9px; background: var(--ds-bg-success); }
    .belofay-overview__all-reviews { display: inline-flex; margin-top: 14px; color: var(--ds-text-supporting); font-weight: 700; text-decoration: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .belofay-overview__chevron { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Belofay product overview",
  "tag": "section",
  "class": "section-belofay-overview",
  "settings": [
    {"type":"text","id":"accordion_label","label":"Mobile accordion label","default":"Overview"},
    {"type":"text","id":"accordion_summary","label":"Mobile accordion summary","default":"Product highlights, included items and reviews."},
    {"type":"header","content":"Introduction"},
    {"type":"text","id":"eyebrow","label":"Mobile eyebrow","default":"BELOFAY"},
    {"type":"text","id":"heading","label":"Heading","default":"A compact vanity made for everyday bathrooms"},
    {"type":"richtext","id":"description","label":"Description","default":"<p>The Crawley 600mm vanity unit with basin combines modern style with practical storage. Its clean, contemporary design and durable finish make it the perfect choice for cloakrooms, ensuites and smaller bathrooms.</p>"},
    {"type":"header","content":"Photography"},
    {"type":"image_picker","id":"main_image","label":"Main lifestyle image"},
    {"type":"text","id":"main_image_alt","label":"Main image alt text","default":"Crawley vanity in a bathroom"},
    {"type":"text","id":"main_image_label","label":"Main image label","default":"Real bathroom context"},

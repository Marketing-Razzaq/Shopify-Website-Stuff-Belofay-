{%- liquid
  assign review_count = 0
  assign photo_count = 0
  for block in section.blocks
    if block.type == 'review'
      assign review_count = review_count | plus: 1
      if block.settings.image_1 != blank or block.settings.image_2 != blank
        assign photo_count = photo_count | plus: 1
      endif
    endif
  endfor
-%}
<section id="reviews" class="belofay-reviews" data-belofay-reviews>
  <div class="belofay-reviews__shell">
    <details class="belofay-reviews__outer" data-reviews-outer>
      <summary class="belofay-reviews__outer-summary"><span><strong>{{ section.settings.heading }}</strong><small>{{ section.settings.mobile_summary }}</small></span><i aria-hidden="true"></i></summary>
      <div class="belofay-reviews__body">
        <header class="belofay-reviews__header"><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.intro }}</div></header>
        <div class="belofay-reviews__summary-grid">
          <article class="belofay-reviews__summary-card" aria-label="Review summary">
            <div class="belofay-reviews__score"><strong>{{ section.settings.average_rating }}</strong><span aria-label="{{ section.settings.average_rating }} out of 5 stars">★★★★★</span><small>{{ section.settings.total_ratings }} ratings</small></div>
            <div class="belofay-reviews__distribution">
              {%- for rating in (1..5) reversed -%}
                {%- assign percent_key = 'rating_' | append: rating -%}{%- assign count_key = percent_key | append: '_count' -%}
                <div><span>{{ rating }} ★</span><i><b style="--percent:{{ section.settings[percent_key] }}%"></b></i><small>{{ section.settings[percent_key] }}% ({{ section.settings[count_key] }})</small></div>
              {%- endfor -%}
            </div>
            <div class="belofay-reviews__recommend"><b aria-hidden="true">✓</b><span><strong>{{ section.settings.recommend_percent }}%</strong><small>would recommend this product</small></span></div>
          </article>
          {%- if photo_count > 0 -%}
            <article class="belofay-reviews__gallery"><h3>{{ section.settings.photos_heading }}</h3><p>{{ section.settings.photos_text }}</p><div>
              {%- for block in section.blocks -%}{%- if block.type == 'review' -%}{%- for index in (1..2) -%}{%- assign key = 'image_' | append: index -%}{%- if block.settings[key] != blank -%}{{ block.settings[key] | image_url: width: 420 | image_tag: loading: 'lazy', widths: '160,240,320,420', sizes: '(max-width:749px) 25vw, 180px', alt: block.settings.title }}{%- endif -%}{%- endfor -%}{%- endif -%}{%- endfor -%}
            </div></article>
          {%- endif -%}
        </div>
        <button class="belofay-reviews__write" type="button" data-review-form-open>{{ section.settings.write_label }} <span aria-hidden="true">→</span></button>
        <div class="belofay-reviews__toolbar">
          <h3><span data-review-visible-count>{{ review_count }}</span> Reviews</h3>
          <div class="belofay-reviews__filters" role="group" aria-label="Filter reviews">
            <button class="is-active" type="button" data-review-filter="all" aria-pressed="true">All reviews ({{ review_count }})</button>
            {%- if photo_count > 0 -%}<button type="button" data-review-filter="photos" aria-pressed="false">With photos ({{ photo_count }})</button>{%- endif -%}
            <button type="button" data-review-filter="5" aria-pressed="false">5 stars</button><button type="button" data-review-filter="4" aria-pressed="false">4 stars</button><button type="button" data-review-filter="low" aria-pressed="false">3 stars & below</button>
          </div>
          <label class="belofay-reviews__sort">Sort:<select data-review-sort><option value="newest">Newest</option><option value="highest">Highest rated</option><option value="lowest">Lowest rated</option></select></label>
        </div>
        <div class="belofay-reviews__list" data-review-list>
          {%- for block in section.blocks -%}{%- if block.type == 'review' -%}
            {%- assign has_photos = false -%}{%- if block.settings.image_1 != blank or block.settings.image_2 != blank -%}{%- assign has_photos = true -%}{%- endif -%}
            <article class="belofay-reviews__card" data-review-card data-rating="{{ block.settings.rating }}" data-date="{{ block.settings.date | escape }}" data-photos="{{ has_photos }}" {{ block.shopify_attributes }}>
              <header><span class="belofay-reviews__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span><div><strong>{{ block.settings.name }}</strong>{%- if block.settings.verified -%}<small class="belofay-reviews__verified">✓ Verified buyer</small>{%- endif -%}<time>{{ block.settings.date }}</time></div><span class="belofay-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">{%- for star in (1..5) -%}{% if star <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}</span></header>
              <h4>{{ block.settings.title }}</h4><div class="belofay-reviews__copy">{{ block.settings.body }}</div>
              {%- if has_photos -%}<div class="belofay-reviews__images">{%- for index in (1..2) -%}{%- assign key = 'image_' | append: index -%}{%- if block.settings[key] != blank -%}{{ block.settings[key] | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240,360,520,700', sizes: '(max-width:749px) 45vw, 300px', alt: block.settings.title }}{%- endif -%}{%- endfor -%}</div>{%- endif -%}
              {%- if block.settings.variant != blank -%}<p class="belofay-reviews__variant">Purchased: {{ block.settings.variant }}</p>{%- endif -%}
              {%- if block.settings.response != blank -%}<aside><strong>Response from BELOFAY</strong><div>{{ block.settings.response }}</div></aside>{%- endif -%}
            </article>
          {%- endif -%}{%- endfor -%}
        </div>
        <button class="belofay-reviews__load" type="button" data-review-load hidden>Load more reviews <span aria-hidden="true">⌄</span></button><p class="belofay-reviews__showing" aria-live="polite" data-review-showing></p>
      </div>
    </details>
  </div>
  <dialog class="belofay-reviews__dialog" data-review-dialog aria-labelledby="ReviewFormTitle">
    <button class="belofay-reviews__dialog-close" type="button" data-review-form-close aria-label="Close review form">×</button>
    <header><button type="button" data-review-form-close>← Back to reviews</button><h2 id="ReviewFormTitle">{{ section.settings.form_heading }}</h2><p>{{ section.settings.form_text }}</p></header>
    {%- form 'contact', class: 'belofay-reviews__form', data-shopify-captcha: 'true' -%}
      {%- if form.posted_successfully? -%}<p class="belofay-reviews__success">{{ section.settings.success_message }}</p>{%- endif -%}{{ form.errors | default_errors }}
      <input type="hidden" name="contact[product]" value="{{ product.title | escape }}"><input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
      <fieldset><legend>Your rating *</legend><div class="belofay-reviews__rating-input">{%- for rating in (1..5) -%}<input id="ReviewRating-{{ section.id }}-{{ rating }}" type="radio" name="contact[rating]" value="{{ rating }}" required><label for="ReviewRating-{{ section.id }}-{{ rating }}"><span class="visually-hidden">{{ rating }} stars</span>☆</label>{%- endfor -%}</div></fieldset>
      <label>Your name *<input type="text" name="contact[name]" autocomplete="name" required></label><label>Email *<input type="email" name="contact[email]" autocomplete="email" required></label><label>Order number <small>(optional)</small><input type="text" name="contact[order_number]"></label><label>Review title <small>(optional)</small><input type="text" name="contact[review_title]" maxlength="100"></label><label>Your review *<textarea name="contact[body]" maxlength="1000" required></textarea></label>
      <button type="submit">Submit review</button><p class="belofay-reviews__moderation">Your review will be checked before publication. Verified-buyer status is added after order confirmation.</p>
    {%- endform -%}
  </dialog>
</section>

{% stylesheet %}
  .belofay-reviews{scroll-margin-top:118px;color:var(--ds-text-strong);background:var(--ds-bg-page);font-family:var(--ds-font-body),Arial,sans-serif}.belofay-reviews__shell{max-width:1600px;margin:0 auto;padding:var(--ds-space-2xl) var(--ds-space-xl) var(--ds-space-section)}.belofay-reviews h2,.belofay-reviews h3,.belofay-reviews h4,.belofay-reviews p{margin-top:0}.belofay-reviews__outer-summary{display:none}.belofay-reviews__header{margin-bottom:var(--ds-space-lg)}.belofay-reviews__header>p{margin-bottom:var(--ds-space-xs);color:var(--ds-action-primary-hover);font-size:var(--ds-text-sm);font-weight:var(--ds-weight-bold);letter-spacing:.16em;text-transform:uppercase}.belofay-reviews__header h2{margin-bottom:10px;color:var(--ds-text-heading);font:var(--ds-weight-bold) clamp(30px,2.25vw,42px)/1.08 var(--ds-font-heading);letter-spacing:-.03em}.belofay-reviews__header>div{max-width:820px;color:var(--ds-text-supporting);font:var(--ds-weight-regular) 19px/1.45 var(--ds-font-body)}
  .belofay-reviews__summary-grid{display:grid;grid-template-columns:minmax(420px,.8fr) minmax(0,1.2fr);gap:var(--ds-space-md)}.belofay-reviews__summary-card,.belofay-reviews__gallery,.belofay-reviews__card{border:1px solid var(--ds-border-default);border-radius:var(--ds-radius-card);background:var(--ds-bg-page)}.belofay-reviews__summary-card{display:grid;grid-template-columns:auto minmax(240px,1fr) auto;gap:var(--ds-space-lg);align-items:center;padding:var(--ds-space-lg)}.belofay-reviews__score{display:grid}.belofay-reviews__score>strong{font-size:52px;line-height:1}.belofay-reviews__score>span,.belofay-reviews__stars{color:var(--ds-action-attention);letter-spacing:1px}.belofay-reviews__score small,.belofay-reviews__variant,.belofay-reviews__showing{color:var(--ds-text-supporting)}.belofay-reviews__distribution{display:grid;gap:7px}.belofay-reviews__distribution>div{display:grid;grid-template-columns:34px minmax(90px,1fr) 72px;gap:8px;align-items:center;font-size:var(--ds-text-sm)}.belofay-reviews__distribution i{height:9px;overflow:hidden;border-radius:99px;background:var(--p-dark-100)}.belofay-reviews__distribution b{display:block;width:var(--percent);height:100%;background:var(--ds-action-primary)}.belofay-reviews__recommend{display:flex;gap:10px;align-items:center;padding-left:var(--ds-space-md);border-left:1px solid var(--ds-border-default)}.belofay-reviews__recommend>b{width:48px;height:48px;display:grid;place-items:center;border-radius:50%;color:#fff;background:var(--ds-action-primary);font-size:28px}.belofay-reviews__recommend span{display:grid}.belofay-reviews__recommend strong{font-size:var(--ds-text-xl)}.belofay-reviews__recommend small{max-width:120px;color:var(--ds-text-supporting)}
  .belofay-reviews__gallery{padding:var(--ds-space-md)}.belofay-reviews__gallery h3{margin-bottom:3px;font-size:var(--ds-text-lg)}.belofay-reviews__gallery p{color:var(--ds-text-supporting)}.belofay-reviews__gallery>div{display:grid;grid-template-columns:repeat(5,minmax(90px,1fr));gap:8px}.belofay-reviews__gallery img{width:100%;height:122px;object-fit:cover;border-radius:var(--ds-radius-control)}.belofay-reviews__write,.belofay-reviews__load,.belofay-reviews__form>button{min-height:52px;display:flex;align-items:center;justify-content:center;border-radius:var(--ds-radius-control);font:var(--ds-weight-bold) var(--ds-text-md)/1 var(--ds-font-body);cursor:pointer;transition:transform var(--motion-duration-fast) var(--motion-ease-standard),background var(--motion-duration-fast) var(--motion-ease-standard)}.belofay-reviews__write{width:min(360px,100%);margin-top:var(--ds-space-md);border:2px solid var(--ds-action-primary);color:#fff;background:var(--ds-action-primary);gap:8px}.belofay-reviews__write:hover,.belofay-reviews__form>button:hover{background:var(--ds-action-primary-hover)}.belofay-reviews__write:active,.belofay-reviews__load:active,.belofay-reviews__form>button:active{transform:scale(var(--motion-press-scale))}
  .belofay-reviews__toolbar{display:grid;grid-template-columns:auto 1fr auto;gap:var(--ds-space-md);align-items:center;margin:var(--ds-space-xl) 0 var(--ds-space-md)}.belofay-reviews__toolbar h3{margin:0;font-size:var(--ds-text-lg)}.belofay-reviews__filters{display:flex;gap:8px;overflow-x:auto}.belofay-reviews__filters button,.belofay-reviews__sort{min-height:44px;padding:9px 16px;border:1px solid var(--ds-control-border);border-radius:999px;color:var(--ds-text-strong);background:#fff;white-space:nowrap}.belofay-reviews__filters button{cursor:pointer}.belofay-reviews__filters button:hover,.belofay-reviews__filters button.is-active{border-color:var(--ds-action-primary);color:var(--ds-action-primary-hover);background:var(--ds-control-selected-bg)}.belofay-reviews__sort{border-radius:var(--ds-radius-control)}.belofay-reviews__sort select{border:0;background:transparent;font:inherit}.belofay-reviews__list{display:grid;gap:var(--ds-space-sm)}.belofay-reviews__card{padding:var(--ds-space-lg)}.belofay-reviews__card[hidden]{display:none}.belofay-reviews__card header{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:12px;align-items:center}.belofay-reviews__avatar{width:52px;height:52px;display:grid;place-items:center;border-radius:50%;background:var(--p-dark-100);font-weight:var(--ds-weight-bold)}.belofay-reviews__card header>div{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center}.belofay-reviews__card header strong{font-size:var(--ds-text-lg)}.belofay-reviews__card time{flex-basis:100%;color:var(--ds-text-supporting)}.belofay-reviews__verified{color:var(--ds-action-primary-hover)}.belofay-reviews__stars{font-size:var(--ds-text-lg)}.belofay-reviews__card h4{margin:var(--ds-space-md) 0 6px;font-size:var(--ds-text-lg)}.belofay-reviews__copy{color:var(--ds-text-supporting);line-height:1.5}.belofay-reviews__copy p{margin-bottom:0}.belofay-reviews__images{display:grid;grid-template-columns:repeat(2,minmax(0,280px));gap:8px;margin-top:var(--ds-space-md)}.belofay-reviews__images img{width:100%;height:180px;object-fit:cover;border-radius:var(--ds-radius-control)}.belofay-reviews__variant{margin:var(--ds-space-sm) 0 0}.belofay-reviews__card aside{margin-top:var(--ds-space-md);padding:var(--ds-space-md);border-left:3px solid var(--ds-action-primary);border-radius:var(--ds-radius-control);background:var(--ds-bg-success)}.belofay-reviews__card aside strong{color:var(--ds-action-primary-hover)}.belofay-reviews__card aside div{margin-top:6px;color:var(--ds-text-supporting)}.belofay-reviews__load{width:100%;margin-top:var(--ds-space-md);border:2px solid var(--ds-action-primary);color:var(--ds-action-primary-hover);background:#fff;gap:8px}.belofay-reviews__showing{margin:8px 0 0;text-align:center}
  .belofay-reviews__dialog{width:min(720px,calc(100% - 32px));max-height:calc(100dvh - 32px);padding:var(--ds-space-xl);border:0;border-radius:var(--ds-radius-large);color:var(--ds-text-strong);box-shadow:0 24px 80px rgb(20 35 58/22%)}.belofay-reviews__dialog::backdrop{background:rgb(20 35 58/50%);backdrop-filter:blur(3px)}.belofay-reviews__dialog-close{position:absolute;top:12px;right:12px;width:44px;height:44px;border:0;border-radius:50%;font-size:28px}.belofay-reviews__dialog header>button{display:none}.belofay-reviews__dialog h2{margin-bottom:8px;font-size:var(--ds-text-2xl)}.belofay-reviews__dialog header p{color:var(--ds-text-supporting)}.belofay-reviews__form{display:grid;gap:var(--ds-space-md)}.belofay-reviews__form label,.belofay-reviews__form fieldset{display:grid;gap:7px;margin:0;padding:0;border:0;font-weight:var(--ds-weight-semibold)}.belofay-reviews__form input[type=text],.belofay-reviews__form input[type=email],.belofay-reviews__form textarea{width:100%;min-height:48px;padding:12px 14px;border:1px solid var(--ds-control-border);border-radius:var(--ds-radius-control);font:var(--ds-weight-regular) var(--ds-text-md)/1.4 var(--ds-font-body)}.belofay-reviews__form textarea{min-height:150px;resize:vertical}.belofay-reviews__rating-input{display:flex;flex-direction:row-reverse;justify-content:flex-end}.belofay-reviews__rating-input input{position:absolute;opacity:0}.belofay-reviews__rating-input label{color:var(--ds-icon-neutral);font-size:42px;line-height:1;cursor:pointer}.belofay-reviews__rating-input input:checked~label,.belofay-reviews__rating-input label:hover,.belofay-reviews__rating-input label:hover~label{color:var(--ds-action-attention)}.belofay-reviews__form>button{border:0;color:#fff;background:var(--ds-action-primary)}.belofay-reviews__moderation{margin:0;padding:var(--ds-space-md);color:var(--ds-text-supporting);background:var(--ds-bg-surface);border-radius:var(--ds-radius-control)}.belofay-reviews__success{padding:var(--ds-space-md);color:var(--ds-action-primary-hover);background:var(--ds-bg-success)}
  @media(max-width:1365px) and (min-width:1025px){.belofay-reviews__summary-grid{grid-template-columns:1fr}}
  @media(max-width:1024px){.belofay-reviews{scroll-margin-top:104px}.belofay-reviews__shell{padding:6px var(--ds-space-md)}.belofay-reviews__outer{overflow:clip;border:1px solid var(--ds-control-border);border-radius:var(--ds-radius-card);background:#fff}.belofay-reviews__outer[open]{border-color:color-mix(in srgb,var(--ds-action-primary),var(--ds-border-default) 55%);background:var(--ds-surface-expanded)}.belofay-reviews__outer-summary{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 16px;cursor:pointer;list-style:none;transition:background var(--motion-duration-fast) var(--motion-ease-standard),transform var(--motion-duration-fast) var(--motion-ease-standard)}.belofay-reviews__outer-summary>span{display:grid}.belofay-reviews__outer-summary strong{font:var(--ds-weight-semibold) 19px/1.2 var(--ds-font-heading)}.belofay-reviews__outer-summary small{margin-top:2px;color:var(--ds-text-supporting);font:var(--ds-weight-regular) var(--ds-text-sm)/1.25 var(--ds-font-body)}.belofay-reviews__outer-summary>i{width:10px;height:10px;border-right:2px solid;border-bottom:2px solid;transform:rotate(45deg);transition:transform var(--motion-duration-base) var(--motion-ease-standard)}.belofay-reviews__outer[open]>summary>i{transform:rotate(225deg)}.belofay-reviews__outer-summary:hover{background:var(--ds-control-selected-bg)}.belofay-reviews__outer-summary:active{transform:scale(var(--motion-press-scale))}.belofay-reviews__body{padding:var(--ds-space-md);border-top:1px solid var(--ds-border-default)}.belofay-reviews__summary-grid{grid-template-columns:1fr}.belofay-reviews__toolbar{grid-template-columns:1fr auto}.belofay-reviews__toolbar h3,.belofay-reviews__filters{grid-column:1/-1}}
  @media(max-width:749px){.belofay-reviews__header h2{font-size:var(--ds-text-2xl)}.belofay-reviews__header>div{font-size:var(--ds-text-md)}.belofay-reviews__summary-card{grid-template-columns:1fr}.belofay-reviews__score{justify-items:center}.belofay-reviews__recommend{justify-content:center;padding:var(--ds-space-md) 0 0;border-top:1px solid var(--ds-border-default);border-left:0}.belofay-reviews__gallery>div{grid-template-columns:repeat(4,minmax(70px,1fr));overflow-x:auto}.belofay-reviews__gallery img{height:96px}.belofay-reviews__write{width:100%}.belofay-reviews__toolbar{grid-template-columns:1fr}.belofay-reviews__sort{justify-self:start}.belofay-reviews__card{padding:var(--ds-space-md)}.belofay-reviews__card header{grid-template-columns:48px minmax(0,1fr)}.belofay-reviews__avatar{width:48px;height:48px}.belofay-reviews__stars{grid-column:2}.belofay-reviews__images img{height:140px}.belofay-reviews__dialog{width:100%;max-width:none;max-height:100dvh;min-height:100dvh;padding:var(--ds-space-lg) var(--ds-space-md);border-radius:0}.belofay-reviews__dialog-close{display:none}.belofay-reviews__dialog header>button{min-height:44px;display:inline-flex;align-items:center;margin-bottom:var(--ds-space-md);padding:0;border:0;background:transparent;font:inherit}}
  @media(prefers-reduced-motion:reduce){.belofay-reviews *,.belofay-reviews *::before,.belofay-reviews *::after{transition-duration:.01ms!important}}
{% endstylesheet %}
{% javascript %}
  (()=>{const root=document.querySelector('[data-belofay-reviews]');if(!root||root.dataset.ready)return;root.dataset.ready='true';const outer=root.querySelector('[data-reviews-outer]'),desktop=matchMedia('(min-width:1025px)'),sync=()=>outer.open=desktop.matches;sync();desktop.addEventListener('change',sync);document.addEventListener('click',e=>{if(e.target.closest('a[href="#reviews"]'))outer.open=true});const cards=[...root.querySelectorAll('[data-review-card]')],filters=[...root.querySelectorAll('[data-review-filter]')],sort=root.querySelector('[data-review-sort]'),load=root.querySelector('[data-review-load]'),showing=root.querySelector('[data-review-showing]'),count=root.querySelector('[data-review-visible-count]');let filter='all',limit=desktop.matches?5:3;const render=()=>{const matches=cards.filter(c=>filter==='all'||filter==='photos'&&c.dataset.photos==='true'||filter==='low'&&+c.dataset.rating<=3||c.dataset.rating===filter);matches.sort((a,b)=>sort.value==='highest'?+b.dataset.rating-+a.dataset.rating:sort.value==='lowest'?+a.dataset.rating-+b.dataset.rating:String(b.dataset.date).localeCompare(String(a.dataset.date)));matches.forEach(c=>c.parentNode.appendChild(c));cards.forEach(c=>c.hidden=true);matches.slice(0,limit).forEach(c=>c.hidden=false);load.hidden=matches.length<=limit;count.textContent=matches.length;showing.textContent=`Showing ${Math.min(limit,matches.length)} of ${matches.length} reviews`};filters.forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.reviewFilter;limit=desktop.matches?5:3;filters.forEach(x=>{const active=x===b;x.classList.toggle('is-active',active);x.setAttribute('aria-pressed',active)});render()}));sort.addEventListener('change',render);load.addEventListener('click',()=>{limit+=desktop.matches?5:3;render()});const dialog=root.querySelector('[data-review-dialog]');root.querySelector('[data-review-form-open]').addEventListener('click',()=>dialog.showModal());dialog.querySelectorAll('[data-review-form-close]').forEach(b=>b.addEventListener('click',()=>dialog.close()));dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});render()})();

{{ 'belofay-pdp-fonts.css' | asset_url | stylesheet_tag }}
{{ 'belofay-pdp-tokens.css' | asset_url | stylesheet_tag }}
{{ 'belofay-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'belofay-pdp.js' | asset_url }}" defer="defer"></script>

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign is_best_seller = false -%}
{%- for product_tag in product.tags -%}
  {%- assign normalized_tag = product_tag | downcase | replace: '-', ' ' | replace: '_', ' ' -%}
  {%- if normalized_tag == 'best seller' or normalized_tag == 'bestseller' -%}
    {%- assign is_best_seller = true -%}
  {%- endif -%}
{%- endfor -%}
<belofay-product
  class="belofay-pdp-hero"
  style="--pdp-included-bg: {{ section.settings.included_background }}; --pdp-warning-bg: {{ section.settings.warning_background }}; --pdp-accent: {{ section.settings.accent_color }}; --pdp-action: {{ section.settings.action_color }}; --pdp-strong-text: {{ section.settings.strong_text_color }}; --pdp-muted-text: {{ section.settings.muted_text_color }};"
>
  {%- if section.settings.show_breadcrumbs -%}
    <div class="belofay-pdp__shell">
      {% render 'belofay-pdp-breadcrumbs', product: product, collection: collection, fallback_collection: section.settings.breadcrumb_collection, home_label: section.settings.breadcrumb_home_label %}
    </div>
  {%- endif -%}
  <div class="belofay-pdp__shell belofay-pdp-hero__layout">
    {% render 'belofay-pdp-media', product: product %}
    <div class="belofay-pdp-hero__info">
      {%- if is_best_seller -%}<span class="belofay-pdp-badge">{{ section.settings.best_seller_label }}</span>{%- endif -%}
      <h1 class="belofay-pdp-hero__title">{{ product.title | escape }}</h1>
      <p class="belofay-pdp-hero__subtitle">{{ section.settings.subtitle }}</p>
      {% render 'belofay-pdp-rating', product: product, fallback_rating: section.settings.rating, fallback_count: section.settings.rating_count %}
      <div class="belofay-pdp-price" aria-live="polite">
        <span class="belofay-pdp-price__current" data-price-current>{{ current_variant.price | money }}</span>
        <span class="belofay-pdp-price__compare" data-price-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}<span class="belofay-pdp-price__saving">Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}</span>{%- endif -%}
      </div>
      {% render 'belofay-pdp-variant-picker', product: product, section_id: section.id, settings: section.settings %}
    </div>
    <div class="belofay-pdp-hero__panels">
      <article class="belofay-pdp__card belofay-pdp-hero__panel"><h2>{{ section.settings.included_heading }}</h2><ul class="belofay-pdp__check-list"><li><span class="belofay-pdp__check" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m5 10 3 3 7-7"/></svg></span>{{ section.settings.included_one }}</li><li><span class="belofay-pdp__check" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m5 10 3 3 7-7"/></svg></span>{{ section.settings.included_two }}</li></ul></article>
      <article class="belofay-pdp__card belofay-pdp-hero__panel belofay-pdp-hero__panel--attention"><h2>{{ section.settings.warning_heading }}</h2><ul class="belofay-pdp__check-list"><li><span class="belofay-pdp__check belofay-pdp__check--warning" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M10 5v6m0 3v.1"/></svg></span><span>{{ section.settings.warning_one }}<br><a class="belofay-pdp-hero__tap-link" href="{{ section.settings.tap_url | default: '/collections/taps' }}">{{ section.settings.tap_link_text }} <span aria-hidden="true">→</span></a></span></li><li><span class="belofay-pdp__check belofay-pdp__check--info" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M10 9v6m0-10v.1"/></svg></span><span><strong>{{ section.settings.warning_two }}</strong><br><span class="belofay-pdp-hero__detail">{{ section.settings.warning_detail }}</span></span></li></ul></article>
    </div>
    <div class="belofay-pdp-delivery-strip">
      <span class="belofay-pdp-delivery-strip__item">{% render 'belofay-pdp-icon', name: 'delivery' %}<span><strong>{{ section.settings.delivery_heading }}</strong><br>{{ section.settings.delivery_text }}</span></span>
      <a class="belofay-pdp-delivery-strip__returns" href="{{ section.settings.returns_link | default: '/policies/refund-policy' }}">{% render 'belofay-pdp-icon', name: 'shield' %}<span>{{ section.settings.returns_link_text }}</span><span aria-hidden="true">→</span></a>
    </div>
    {% render 'belofay-pdp-buy-buttons', product: product, settings: section.settings %}
  </div>
  <div class="belofay-pdp__shell belofay-pdp-suggestions-row">
    {% render 'belofay-pdp-tap-suggestions', blocks: section.blocks, heading: section.settings.suggestions_heading, description: section.settings.suggestions_description %}
  </div>
  <script type="application/json" data-belofay-variants>
    [
      {%- for variant in product.variants -%}
        {"id":{{ variant.id | json }},"title":{{ variant.title | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price_formatted":{{ variant.price | money | json }},"compare_at_price_formatted":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},"featured_media_id":{% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %},"url":{{ product.url | append: '?variant=' | append: variant.id | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</belofay-product>

{% schema %}
{
  "name": "Belofay PDP hero",
  "settings": [
    {"type":"header","content":"Breadcrumbs"},
    {"type":"checkbox","id":"show_breadcrumbs","label":"Show breadcrumbs","default":true},
    {"type":"collection","id":"breadcrumb_collection","label":"Fallback collection"},
    {"type":"text","id":"breadcrumb_home_label","label":"Home label","default":"Home"},
    {"type":"header","content":"Product header"},
    {"type":"text","id":"best_seller_label","label":"Best seller label","default":"Best Seller"},
    {"type":"text","id":"subtitle","label":"Product summary","default":"Floor-standing · Soft-close · Premium finish"},
    {"type":"range","id":"rating","label":"Fallback rating","min":1,"max":5,"step":0.1,"default":4.5},
    {"type":"number","id":"rating_count","label":"Fallback rating count","default":121},
    {"type":"header","content":"Product options"},
    {"type":"text","id":"size_label","label":"Size option label","default":"Size (Width)"},
    {"type":"text","id":"dimension_depth","label":"Depth","default":"388mm D"},
    {"type":"text","id":"dimension_height","label":"Height","default":"800mm H"},
    {"type":"text","id":"option_error_text","label":"Selection error","default":"Please select an option"},
    {"type":"header","content":"Information panels"},
    {"type":"text","id":"included_heading","label":"Included heading","default":"What’s included"},
    {"type":"text","id":"included_one","label":"Included item one","default":"Ceramic basin included"},
    {"type":"text","id":"included_two","label":"Included item two","default":"Chrome waste included"},
    {"type":"text","id":"warning_heading","label":"Warning heading","default":"Before you buy"},
    {"type":"text","id":"warning_one","label":"Warning one","default":"Tap not included"},
    {"type":"text","id":"tap_link_text","label":"Tap link text","default":"Shop matching taps"},
    {"type":"url","id":"tap_url","label":"Tap collection link"},
    {"type":"text","id":"warning_two","label":"Warning two","default":"Quick self-assembly"},
    {"type":"text","id":"warning_detail","label":"Assembly detail","default":"Approx. 30 min · Basic tools · Plumbing connection required"},
    {"type":"text","id":"delivery_heading","label":"Delivery heading","default":"FREE UK DELIVERY"},
    {"type":"text","id":"delivery_text","label":"Delivery text","default":"Cabinet and basin may arrive separately"},
    {"type":"text","id":"returns_link_text","label":"Returns link text","default":"30-day returns policy"},
    {"type":"url","id":"returns_link","label":"Returns policy link"},
    {"type":"header","content":"Purchase buttons"},
    {"type":"text","id":"add_to_cart_label","label":"Add to cart label","default":"Add to Cart"},
    {"type":"text","id":"buy_now_label","label":"Buy now label","default":"Buy Now"},
    {"type":"text","id":"sold_out_label","label":"Sold out label","default":"Sold out"},
    {"type":"header","content":"Purchase reassurance"},
    {"type":"text","id":"secure_heading","label":"Secure checkout heading","default":"Secure checkout"},
    {"type":"text","id":"secure_text","label":"Secure checkout text","default":"Your information is safe"},
    {"type":"text","id":"support_heading","label":"Support heading","default":"UK support"},
    {"type":"text","id":"support_text","label":"Support text","default":"Here to help"},
    {"type":"text","id":"returns_heading","label":"Returns heading","default":"30-day returns"},
    {"type":"text","id":"returns_text","label":"Returns text","default":"Shop with confidence"},
    {"type":"header","content":"Tap recommendations"},
    {"type":"text","id":"suggestions_heading","label":"Heading","default":"Complete the look"},
    {"type":"text","id":"suggestions_description","label":"Description","default":"Compatible accessories for this product"},
    {"type":"header","content":"Hero colors"},
    {"type":"color","id":"action_color","label":"Action green","default":"#20a957"},
    {"type":"color","id":"accent_color","label":"Accent orange","default":"#ff6b00"},
    {"type":"color","id":"strong_text_color","label":"Strong text","default":"#14233a"},
    {"type":"color","id":"muted_text_color","label":"Muted text","default":"#5f6d80"},
    {"type":"color","id":"included_background","label":"Included panel background","default":"#effaf3"},
    {"type":"color","id":"warning_background","label":"Before you buy background","default":"#fff4ed"}
  ],
  "blocks": [
    {
      "type": "tap_suggestion",
      "name": "Tap suggestion",
      "limit": 3,
      "settings": [
        {"type":"product","id":"product","label":"Tap product"},
        {"type":"image_picker","id":"image","label":"Custom image"},
        {"type":"text","id":"title","label":"Custom title"},
        {"type":"url","id":"link","label":"Custom link"}
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}

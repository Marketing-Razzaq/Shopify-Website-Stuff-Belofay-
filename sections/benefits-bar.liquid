{% comment %}
  Benefits bar — row of company selling points with icons.
  Sits below the collection nav in the header group.
{% endcomment %}

<div class="benefits-bar{% if section.settings.hide_mobile %} benefits-bar--hide-mobile{% endif %}" style="padding-top: {{ section.settings.padding_top | default: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px; --bb-bg: {{ section.settings.background_color | default: '#ffffff' }}; --bb-text: {{ section.settings.text_color | default: '#333355' }};">
  <div class="benefits-bar__inner">
    {%- for block in section.blocks -%}
      <div class="benefits-bar__item" {{ block.shopify_attributes }}>
        <span class="benefits-bar__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              {{ 'delivery_truck.svg' | inline_asset_content }}
            {%- when 'returns' -%}
              {{ 'icon-box.svg' | inline_asset_content }}
            {%- when 'star' -%}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15 8.5 22 9.3 17 14 18.5 21 12 17.5 5.5 21 7 14 2 9.3 9 8.5"/></svg>
            {%- when 'help' -%}
              {{ 'support_headset.svg' | inline_asset_content }}
            {%- else -%}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="8 12 11 15 16 9"/></svg>
          {%- endcase -%}
        </span>
        <span class="benefits-bar__text">
          <span class="benefits-bar__title">{{ block.settings.title }}</span>
          <span class="benefits-bar__subtitle">{{ block.settings.subtitle }}</span>
        </span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .benefits-bar {
    background: var(--bb-bg, #fff);
    color: var(--bb-text, #333355);
    border-top: 1px solid rgb(0 0 0 / 8%);
    border-bottom: 1px solid rgb(0 0 0 / 8%);
  }

  .benefits-bar__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
    gap: 0.75rem 2rem;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0.7rem 1rem;
  }

  .benefits-bar__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .benefits-bar__icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .benefits-bar__text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .benefits-bar__title {
    font-weight: 700;
    font-size: 1.4rem;
  }

  .benefits-bar__subtitle {
    font-size: 1.2rem;
    opacity: 0.85;
  }

  @media screen and (max-width: 749px) {
    .benefits-bar--hide-mobile {
      display: none;
    }

    .benefits-bar__inner {
      justify-content: flex-start;
      gap: 0.6rem 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Benefits bar",
  "settings": [
    { "type": "checkbox", "id": "hide_mobile", "label": "Hide on mobile", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333355"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check",
          "options": [
            { "value": "truck", "label": "Delivery truck" },
            { "value": "returns", "label": "Returns arrow" },
            { "value": "star", "label": "Star" },
            { "value": "help", "label": "Help / question" },
            { "value": "check", "label": "Checkmark" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free UK Delivery"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "When you spend over £70"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Benefits bar"
    }
  ]
}
{% endschema %}

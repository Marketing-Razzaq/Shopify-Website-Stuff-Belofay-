{% comment %}
  Collection navigation bar with search — sits below the main header.
  Users add/remove collection links as blocks in the theme editor.
{% endcomment %}

<div class="collection-nav{% if section.settings.hide_mobile %} collection-nav--hide-mobile{% endif %}" style="padding-top: {{ section.settings.padding_top | default: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px; --cn-bg: {{ section.settings.background_color | default: '#ffffff' }}; --cn-text: {{ section.settings.text_color | default: '#333355' }};">
  {%- if section.settings.show_search -%}
    <div class="collection-nav__search-row" id="collection-nav-search-row">
      <form action="{{ routes.search_url }}" method="get" role="search" class="collection-nav__search-form">
        <input
          type="search"
          name="q"
          class="collection-nav__search-input"
          placeholder="{{ section.settings.search_placeholder | default: 'Search...' }}"
          aria-label="Search products"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="collection-nav__search-button" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
          </svg>
        </button>
      </form>
    </div>
  {%- endif -%}

  <nav class="collection-nav__links" aria-label="Collections">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'collection' -%}
          {%- if block.settings.collection != blank -%}
            <a href="{{ block.settings.collection.url }}" class="collection-nav__link" {{ block.shopify_attributes }}>
              {{ block.settings.label | default: block.settings.collection.title }}
            </a>
          {%- endif -%}
        {%- when 'collections_dropdown' -%}
          <div class="collection-nav__dropdown" {{ block.shopify_attributes }}>
            <button type="button" class="collection-nav__link collection-nav__dropdown-toggle" aria-expanded="false" aria-haspopup="true">
              {{ block.settings.label | default: 'Collections' }}
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="collection-nav__dropdown-menu">
              {%- if block.settings.collections.count > 0 -%}
                {%- for collection in block.settings.collections -%}
                  <a href="{{ collection.url }}" class="collection-nav__dropdown-item">{{ collection.title }}</a>
                {%- endfor -%}
              {%- else -%}
                {%- for collection in collections -%}
                  {%- unless collection.handle == 'frontpage' -%}
                    <a href="{{ collection.url }}" class="collection-nav__dropdown-item">
                      {%- if collection.handle == 'all' -%}All Products{%- else -%}{{ collection.title }}{%- endif -%}
                    </a>
                  {%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        {%- when 'collection_dropdown' -%}
          {%- assign dd_cols = block.settings.collections -%}
          {%- if dd_cols.count > 0 -%}
            {%- assign first_col = dd_cols.first -%}
            <div class="collection-nav__dropdown" {{ block.shopify_attributes }}>
              <button type="button" class="collection-nav__link collection-nav__dropdown-toggle" aria-expanded="false" aria-haspopup="true">
                {{ block.settings.label | default: first_col.title }}
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div class="collection-nav__dropdown-menu">
                {%- for col in dd_cols -%}
                  <a href="{{ col.url }}" class="collection-nav__dropdown-item">{{ col.title }}</a>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- when 'link' -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="collection-nav__link" {{ block.shopify_attributes }}>
              {{ block.settings.label }}
            </a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </nav>
</div>

<script>
  (function () {
    function moveSearch() {
      var header = document.querySelector('.header-wrapper header.header');
      if (!header) return;
      // Find the search row, wherever it currently lives (section or already moved)
      var row = document.querySelector('.collection-nav .collection-nav__search-row')
        || document.querySelector('.collection-nav__search-row--in-header');
      if (!row) return;
      // Remove stale duplicates (e.g. after a theme editor re-render), keeping `row`
      document.querySelectorAll('.collection-nav__search-row--in-header').forEach(function (el) {
        if (el !== row) el.remove();
      });
      row.classList.add('collection-nav__search-row--in-header');
      if (row.parentElement !== header) header.appendChild(row);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', moveSearch);
    } else {
      moveSearch();
    }
    // Re-place the search bar after theme editor section re-renders
    document.addEventListener('shopify:section:load', moveSearch);

    // Keep aria-expanded in sync for the collections dropdown
    document.addEventListener('focusin', syncDropdowns);
    document.addEventListener('mouseover', syncDropdowns);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.collection-nav__dropdown-toggle').forEach(function (btn) {
          btn.setAttribute('aria-expanded', 'false');
          btn.blur();
        });
      }
    });
    function syncDropdowns() {
      document.querySelectorAll('.collection-nav__dropdown').forEach(function (dd) {
        var btn = dd.querySelector('.collection-nav__dropdown-toggle');
        if (!btn) return;
        var open = dd.matches(':hover') || dd.contains(document.activeElement);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
  })();
</script>

{% stylesheet %}
  .collection-nav {
    background: var(--cn-bg, #fff);
    border-bottom: 1px solid rgb(0 0 0 / 8%);
  }

  .collection-nav__search-row {
    display: flex;
    justify-content: center;
    padding: 0.75rem 1rem 0.25rem;
  }

  .collection-nav__search-form {
    display: flex;
    width: 100%;
    max-width: 480px;
    border: 1px solid rgb(0 0 0 / 25%);
    border-radius: 4px;
    overflow: hidden;
    background: #fff;
  }

  .collection-nav__search-input {
    flex: 1;
    border: none;
    outline: none;
    padding: 0.55rem 0.9rem;
    font-size: 1.4rem;
    background: transparent;
    color: #333;
  }

  .collection-nav__search-button {
    border: none;
    cursor: pointer;
    padding: 0 1rem;
    background: var(--cn-text, #333355);
    color: #fff;
    display: flex;
    align-items: center;
  }

  /* Search bar relocated into the header, centered on the logo row */
  .header-wrapper header.header {
    position: relative;
  }

  .collection-nav__search-row--in-header {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(480px, 36vw);
    padding: 0;
    margin: 0;
    min-width: 0;
    z-index: 4;
  }

  .collection-nav__search-row--in-header .collection-nav__search-form {
    margin: 0 auto;
    width: 100%;
  }

  /* Hide the theme's built-in inline menu and search icon (replaced by this bar) */
  .header__inline-menu,
  .header__icons details-modal.header__search,
  .header__icons .header__search {
    display: none !important;
  }

  @media screen and (max-width: 989px) {
    /* Not enough room beside the logo on smaller screens — full-width row below */
    .collection-nav__search-row--in-header {
      position: static;
      transform: none;
      grid-column: 1 / -1;
      grid-row: 3;
      width: 100%;
      padding: 0.5rem 0 0.25rem;
      display: flex;
      justify-content: center;
    }
  }

  .collection-nav__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.75rem;
    padding: 0.6rem 1rem 0.8rem;
  }

  .collection-nav__link {
    color: var(--cn-text, #333355);
    text-decoration: none;
    font-size: 1.5rem;
    padding: 0.25rem 0;
  }

  .collection-nav__dropdown {
    position: relative;
    display: inline-flex;
  }

  .collection-nav__dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    font-size: 1.5rem;
    padding: 0;
  }

  .collection-nav__dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 220px;
    max-height: 60vh;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    padding: 8px 0;
    z-index: 30;
    display: none;
    flex-direction: column;
  }

  .collection-nav__dropdown:hover .collection-nav__dropdown-menu,
  .collection-nav__dropdown:focus-within .collection-nav__dropdown-menu {
    display: flex;
  }

  .collection-nav__dropdown-item {
    padding: 9px 18px;
    text-decoration: none;
    color: inherit;
    font-size: 1.4rem;
    white-space: nowrap;
  }

  .collection-nav__dropdown-item--all {
    font-weight: 700;
  }

  .collection-nav__dropdown-item:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .collection-nav__link:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .collection-nav--hide-mobile {
      display: none;
    }

    .collection-nav__links {
      gap: 0.25rem 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection nav bar",
  "settings": [
    { "type": "checkbox", "id": "hide_mobile", "label": "Hide on mobile", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search..."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333355"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection link",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label (optional)"
        }
      ]
    },
    {
      "type": "collections_dropdown",
      "name": "Collections dropdown",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Collections"
        },
        {
          "type": "collection_list",
          "id": "collections",
          "label": "Collections to show",
          "limit": 10,
          "info": "Leave empty to list every collection in the store."
        }
      ]
    },
    {
      "type": "collection_dropdown",
      "name": "Collection dropdown",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "collection_list",
          "id": "collections",
          "label": "Collection(s)",
          "limit": 5,
          "info": "One collection: dropdown lists its products. Several: dropdown lists the collections."
        }
      ]
    },
    {
      "type": "link",
      "name": "Custom link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Trade Customers"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Collection nav bar"
    }
  ]
}
{% endschema %}

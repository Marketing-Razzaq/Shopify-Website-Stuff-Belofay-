{%- comment -%}
  Custom robots.txt — keeps all default Shopify rules, then blocks
  Amazonbot and known scraper / price-monitoring crawlers site-wide.
  Google, Bing and other search engines are unaffected.
{%- endcomment -%}
{%- for group in robots.default_groups -%}
  {{ group.user_agent }}
  {%- for rule in group.rules %}
  {{ rule }}
  {%- endfor %}
  {%- if group.sitemap != blank %}
  {{ group.sitemap }}
  {%- endif %}
{% endfor %}


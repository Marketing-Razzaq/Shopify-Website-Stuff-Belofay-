{% doc %}
Renders up to three merchant-selected tap recommendation cards.
@param {object} blocks - Tap suggestion blocks from the parent section.
@param {string} heading - Recommendation group heading.
@example
{% render 'belofay-pdp-tap-suggestions', blocks: section.blocks, heading: section.settings.suggestions_heading %}
{% enddoc %}

{%- if blocks.size > 0 -%}
  <section class="belofay-pdp-suggestions" aria-labelledby="BelofayTapSuggestions">
    <h2 id="BelofayTapSuggestions">{{ heading }}</h2>
    <div class="belofay-pdp-suggestions__grid">
      {%- for block in blocks limit: 3 -%}
        {%- assign suggested_product = block.settings.product -%}
        {%- assign card_image = block.settings.image | default: suggested_product.featured_image -%}
        {%- assign card_title = block.settings.title | default: suggested_product.title | default: 'Matching tap' -%}
        {%- assign card_url = block.settings.link | default: suggested_product.url | default: '/collections/taps' -%}
        <article class="belofay-pdp-suggestion" {{ block.shopify_attributes }}>
          <a class="belofay-pdp-suggestion__link" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
            <span class="belofay-pdp-suggestion__media">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '180, 260, 360, 480', sizes: '(max-width: 749px) 42vw, 240px', alt: card_title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
            <span class="belofay-pdp-suggestion__title">{{ card_title }}</span>
            {%- if suggested_product != blank -%}<span class="belofay-pdp-suggestion__price">{{ suggested_product.price | money }}</span>{%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

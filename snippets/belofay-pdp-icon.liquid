{% doc %}
Renders a small decorative icon for the Belofay PDP.
@param {string} name - Icon name.
@example
{% render 'belofay-pdp-icon', name: 'delivery' %}
{% enddoc %}

{%- case name -%}
  {%- when 'delivery' -%}
    <span class="belofay-pdp__icon" aria-hidden="true">{{ 'delivery_truck.svg' | inline_asset_content }}</span>
  {%- when 'measure' -%}
    <span class="belofay-pdp__icon" aria-hidden="true">{{ 'measurement_ruler.svg' | inline_asset_content }}</span>
  {%- when 'lock' -%}
    <span class="belofay-pdp__icon" aria-hidden="true">{{ 'secure_lock.svg' | inline_asset_content }}</span>
  {%- when 'shield' -%}
    <span class="belofay-pdp__icon" aria-hidden="true">{{ 'shield_check.svg' | inline_asset_content }}</span>
  {%- when 'cart' -%}
    <span class="belofay-pdp__icon" aria-hidden="true">{{ 'shopping_cart.svg' | inline_asset_content }}</span>
  {%- when 'support' -%}
    <span class="belofay-pdp__icon" aria-hidden="true">{{ 'support_headset.svg' | inline_asset_content }}</span>
  {%- when 'tools' -%}
    <svg class="belofay-pdp__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6 4-3 3 3-3 4m-4-4-9 9a3 3 0 0 0 4 4l9-9M5 4l4 4m-5 1 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  {%- else -%}
    <svg class="belofay-pdp__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m8 12 2.5 2.5L16 9" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
{%- endcase -%}

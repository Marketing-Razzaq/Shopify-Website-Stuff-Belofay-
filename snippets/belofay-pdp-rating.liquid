{% doc %}
Renders the Belofay product rating summary without an app block.
@param {product} product - Product whose native rating metafields are read.
@param {number} fallback_rating - Rating shown when no metafield exists.
@param {number} fallback_count - Rating count shown when no metafield exists.
@example
{% render 'belofay-pdp-rating', product: product, fallback_rating: 4.5, fallback_count: 121 %}
{% enddoc %}

{%- liquid
  assign rating = fallback_rating
  assign count = fallback_count
  if product.metafields.reviews.rating.value != blank
    assign rating = product.metafields.reviews.rating.value.rating
  endif
  if product.metafields.reviews.rating_count != blank
    assign count = product.metafields.reviews.rating_count
  endif
-%}
<div class="belofay-pdp-rating" aria-label="Rated {{ rating }} out of 5 from {{ count }} reviews">
  <span class="belofay-pdp-rating__stars" aria-hidden="true">★★★★★</span>
  <span class="belofay-pdp-rating__meta">{{ rating }} <span aria-hidden="true">|</span> {{ count }} reviews</span>
</div>

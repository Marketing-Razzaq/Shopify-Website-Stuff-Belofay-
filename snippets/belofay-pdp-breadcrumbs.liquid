{% doc %}
Renders accessible product breadcrumbs with optional collection context and structured data.

@param {product} product - Current product.
@param {collection} [collection] - Collection from the current storefront context.
@param {collection} [fallback_collection] - Merchant-selected collection used when context is unavailable.
@param {string} home_label - Label for the storefront home link.
@param {string} [aria_label] - Accessible label for the breadcrumb navigation.

@example
{% render 'belofay-pdp-breadcrumbs', product: product, collection: collection, fallback_collection: section.settings.breadcrumb_collection, home_label: section.settings.breadcrumb_home_label %}
{% enddoc %}

{%- liquid
  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank
    assign breadcrumb_collection = fallback_collection
  endif
  assign breadcrumb_aria_label = aria_label | default: 'Breadcrumb'
-%}

<nav class="belofay-pdp-breadcrumbs" aria-label="{{ breadcrumb_aria_label | escape }}">
  <ol class="belofay-pdp-breadcrumbs__list">
    <li class="belofay-pdp-breadcrumbs__item">
      <a href="{{ routes.root_url }}">{{ home_label | escape }}</a>
    </li>
    {%- if breadcrumb_collection != blank -%}
      <li class="belofay-pdp-breadcrumbs__item">
        <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title | escape }}</a>
      </li>
    {%- endif -%}
    <li class="belofay-pdp-breadcrumbs__item belofay-pdp-breadcrumbs__item--current" aria-current="page">
      <span>{{ product.title | escape }}</span>
    </li>
  </ol>
</nav>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ home_label | json }},
        "item": {{ shop.url | append: routes.root_url | json }}
      }{% if breadcrumb_collection != blank %},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ breadcrumb_collection.title | json }},
        "item": {{ shop.url | append: breadcrumb_collection.url | json }}
      }{% endif %},
      {
        "@type": "ListItem",
        "position": {% if breadcrumb_collection != blank %}3{% else %}2{% endif %},
        "name": {{ product.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
</script>

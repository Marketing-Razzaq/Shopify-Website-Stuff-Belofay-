{% doc %}
Renders the Belofay Add to Cart, Buy Now, reassurance row and mobile sticky action.
@param {product} product - Product to purchase.
@param {object} settings - Parent section settings.
@example
{% render 'belofay-pdp-buy-buttons', product: product, settings: section.settings %}
{% enddoc %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
<div class="belofay-pdp-buy" data-belofay-purchase>
  <div class="belofay-pdp-buy__errors" role="alert" data-purchase-error hidden></div>
  <div class="belofay-pdp-buy__actions">
    <button class="belofay-pdp-buy__submit" type="button" data-product-submit data-available-label="{{ settings.add_to_cart_label | escape }}" data-sold-out-label="{{ settings.sold_out_label | escape }}" {% unless current_variant.available %}disabled{% endunless %}>
      {% render 'belofay-pdp-icon', name: 'cart' %}
      <span data-submit-label>{% if current_variant.available %}{{ settings.add_to_cart_label }}{% else %}{{ settings.sold_out_label }}{% endif %}</span>
    </button>
    <button class="belofay-pdp-buy__now" type="button" data-buy-now {% unless current_variant.available %}disabled{% endunless %}><span data-button-label>{{ settings.buy_now_label }}</span></button>
  </div>
  <div class="belofay-pdp-buy__reassurance">
    <div class="belofay-pdp-reassurance"><svg class="belofay-pdp__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="12" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4m-4 5v3"/></svg><span><strong>{{ settings.secure_heading | default: 'Secure Checkout' }}</strong><small>{{ settings.secure_text | default: 'Protected payment processing' }}</small></span></div>
    <div class="belofay-pdp-reassurance"><svg class="belofay-pdp__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14v-3a8 8 0 0 1 16 0v3m0 3v1a4 4 0 0 1-4 4h-3"/><rect x="2" y="11" width="4" height="7" rx="2"/><rect x="18" y="11" width="4" height="7" rx="2"/><path d="M10 22h3"/></svg><span><strong>{{ settings.support_heading | default: 'Customer Support' }}</strong><small>{{ settings.support_text | default: 'Help when you need it' }}</small></span></div>
    <div class="belofay-pdp-reassurance"><svg class="belofay-pdp__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 4v6c0 5-5 8-9 10-4-2-9-5-9-10V6l9-4Z"/><path d="m8 12 3 3 5-6"/></svg><span><strong>{{ settings.returns_heading | default: '30-Day Returns' }}</strong><small>{{ settings.returns_text }}</small></span></div>
  </div>
</div>

<button class="belofay-pdp-mobile-buy-now" type="button" data-buy-now {% unless current_variant.available %}disabled{% endunless %}><span data-button-label>{{ settings.buy_now_label }}</span></button>

<div class="belofay-pdp-sticky" aria-label="Sticky purchase controls" aria-hidden="true">
  <div class="belofay-pdp-sticky__summary">
    {%- if current_variant.featured_image != blank -%}
      {{ current_variant.featured_image | image_url: width: 100 | image_tag: loading: 'lazy' }}
    {%- elsif product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    <span><span class="belofay-pdp-sticky__variant" data-sticky-variant>{{ current_variant.title }}</span><strong class="belofay-pdp-sticky__price" data-sticky-price>{{ current_variant.price | money }}</strong></span>
  </div>
  <button class="belofay-pdp-sticky__button" type="button" data-sticky-submit data-available-label="{{ settings.add_to_cart_label | escape }}" data-sold-out-label="{{ settings.sold_out_label | escape }}" {% unless current_variant.available %}disabled{% endunless %}><span data-submit-label>{% if current_variant.available %}{{ settings.add_to_cart_label }}{% else %}{{ settings.sold_out_label }}{% endif %}</span></button>
  <button class="belofay-pdp-sticky__buy-now" type="button" data-buy-now {% unless current_variant.available %}disabled{% endunless %}><span data-button-label>{{ settings.buy_now_label }}</span></button>
</div>

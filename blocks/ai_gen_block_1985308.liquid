{% doc %}
  @prompt
    Create a customizable image banner section with logo and text overlay. The section should include options to upload a background image, add a logo image that can be positioned on top of the banner, and include customizable text that appears over the banner. Include settings for text positioning, color, and size, as well as logo positioning and size controls., Add text overlays at the top right and botton left for free shipping and 30 day returns., Add the options to change fonts to the overlays we just added
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.banner_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-banner-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
    opacity: 0.3;
  }

  .ai-image-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .ai-image-banner-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-image-banner-logo-{{ ai_gen_id }} {
    position: absolute;
    z-index: 4;
    {% case block.settings.logo_position %}
      {% when 'top-left' %}
        top: {{ block.settings.logo_offset_vertical }}px;
        left: {{ block.settings.logo_offset_horizontal }}px;
      {% when 'top-center' %}
        top: {{ block.settings.logo_offset_vertical }}px;
        left: 50%;
        transform: translateX(-50%);
      {% when 'top-right' %}
        top: {{ block.settings.logo_offset_vertical }}px;
        right: {{ block.settings.logo_offset_horizontal }}px;
      {% when 'center-left' %}
        top: 50%;
        left: {{ block.settings.logo_offset_horizontal }}px;
        transform: translateY(-50%);
      {% when 'center-center' %}
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      {% when 'center-right' %}
        top: 50%;
        right: {{ block.settings.logo_offset_horizontal }}px;
        transform: translateY(-50%);
      {% when 'bottom-left' %}
        bottom: {{ block.settings.logo_offset_vertical }}px;
        left: {{ block.settings.logo_offset_horizontal }}px;
      {% when 'bottom-center' %}
        bottom: {{ block.settings.logo_offset_vertical }}px;
        left: 50%;
        transform: translateX(-50%);
      {% when 'bottom-right' %}
        bottom: {{ block.settings.logo_offset_vertical }}px;
        right: {{ block.settings.logo_offset_horizontal }}px;
    {% endcase %}
  }

  .ai-image-banner-logo-{{ ai_gen_id }} img {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    max-width: 100%;
    border-radius: {{ block.settings.logo_border_radius }}px;
  }

  .ai-image-banner-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.text_max_width }}px;
    width: 100%;
  }

  .ai-image-banner-heading-{{ ai_gen_id }} {
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: {{ settings.type_header_font.weight }};
    font-style: {{ settings.type_header_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
  }

  .ai-image-banner-subheading-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-style: {{ settings.type_body_font.style }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
  }

  .ai-image-banner-description-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-style: {{ settings.type_body_font.style }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
    color: {{ block.settings.description_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
  }

  .ai-image-banner-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ settings.buttons_radius }}px;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-size: {{ block.settings.button_text_size }}px;
    transition: all 0.3s ease;
    border: {{ settings.buttons_border_thickness }}px solid {{ block.settings.button_background_color }};
    margin-top: {{ block.settings.text_spacing }}px;
  }

  .ai-image-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_background_color }};
  }

  .ai-image-banner-overlay-text-{{ ai_gen_id }} {
    position: absolute;
    z-index: 5;
    font-family: {{ block.settings.overlay_text_font.family }}, {{ block.settings.overlay_text_font.fallback_families }};
    font-weight: {{ block.settings.overlay_text_font.weight }};
    font-style: {{ block.settings.overlay_text_font.style }};
    font-size: {{ block.settings.overlay_text_size }}px;
    color: {{ block.settings.overlay_text_color }};
    background-color: {{ block.settings.overlay_text_background }};
    padding: {{ block.settings.overlay_text_padding }}px {{ block.settings.overlay_text_padding | times: 1.5 }}px;
    border-radius: {{ block.settings.overlay_text_border_radius }}px;
    white-space: nowrap;
    font-weight: 600;
  }

  .ai-image-banner-overlay-text-top-right-{{ ai_gen_id }} {
    top: {{ block.settings.overlay_text_offset }}px;
    right: {{ block.settings.overlay_text_offset }}px;
  }

  .ai-image-banner-overlay-text-bottom-left-{{ ai_gen_id }} {
    bottom: {{ block.settings.overlay_text_offset }}px;
    left: {{ block.settings.overlay_text_offset }}px;
  }

  .ai-image-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 6px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    z-index: 5;
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.banner_height | times: 0.7 }}px;
    }

    .ai-image-banner-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }

    .ai-image-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-image-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-image-banner-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-image-banner-logo-{{ ai_gen_id }} img {
      width: {{ block.settings.logo_width | times: 0.8 }}px;
    }

    .ai-image-banner-text-container-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-image-banner-overlay-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.overlay_text_size | times: 0.9 }}px;
      padding: {{ block.settings.overlay_text_padding | times: 0.8 }}px {{ block.settings.overlay_text_padding | times: 1.2 }}px;
    }

    .ai-image-banner-overlay-text-top-right-{{ ai_gen_id }},
    .ai-image-banner-overlay-text-bottom-left-{{ ai_gen_id }} {
      top: {{ block.settings.overlay_text_offset | times: 0.7 }}px;
      right: {{ block.settings.overlay_text_offset | times: 0.7 }}px;
      bottom: {{ block.settings.overlay_text_offset | times: 0.7 }}px;
      left: {{ block.settings.overlay_text_offset | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-image-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.background_image %}
    <img
      src="{{ block.settings.background_image | image_url: width: 2000 }}"
      alt="{{ block.settings.background_image.alt | escape }}"
      class="ai-image-banner-background-{{ ai_gen_id }}"
      loading="lazy"
      width="{{ block.settings.background_image.width }}"
      height="{{ block.settings.background_image.height }}"
    >
  {% else %}
    <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    </div>
  {% endif %}

  {% if block.settings.show_overlay %}
    <div class="ai-image-banner-overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  {% if block.settings.logo_image and block.settings.show_logo %}
    <div class="ai-image-banner-logo-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.logo_image | image_url: width: 400 }}"
        alt="{{ block.settings.logo_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.logo_image.width }}"
        height="{{ block.settings.logo_image.height }}"
      >
    </div>
  {% endif %}

  {% if block.settings.show_overlay_text_top_right and block.settings.overlay_text_top_right != blank %}
    <div class="ai-image-banner-overlay-text-{{ ai_gen_id }} ai-image-banner-overlay-text-top-right-{{ ai_gen_id }}">
      {{ block.settings.overlay_text_top_right }}
    </div>
  {% endif %}

  {% if block.settings.show_overlay_text_bottom_left and block.settings.overlay_text_bottom_left != blank %}
    <div class="ai-image-banner-overlay-text-{{ ai_gen_id }} ai-image-banner-overlay-text-bottom-left-{{ ai_gen_id }}">
      {{ block.settings.overlay_text_bottom_left }}
    </div>
  {% endif %}

  <div class="ai-image-banner-content-{{ ai_gen_id }}">
    <div class="ai-image-banner-text-container-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-image-banner-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <h3 class="ai-image-banner-subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </h3>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-image-banner-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-image-banner-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>

  {% unless block.settings.background_image %}
    <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
      Add a background image to get started
    </div>
  {% endunless %}
</div>

{% schema %}

{% doc %}
  @prompt
    A section that has an about us column, Customer services column and policies column., Make the buttons under the policies section lead to our actual policies on shopify. SAme for the buttons under Customer services. GEt rid of FAQ, track order and returs + exchanges., Make the contact us button lead to the contact page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-info-columns-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-info-columns__container-{{ ai_gen_id }} {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: {{ block.settings.column_gap }}px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.ai-info-columns__list-{{ ai_gen_id }} {
  list-style: disc;
  padding-left: 20px;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: {{ block.settings.item_spacing }}px;
}

.ai-info-columns__text-{{ ai_gen_id }} p {
  margin: 0 0 16px;
}

.ai-info-columns__heading-{{ ai_gen_id }} {
  font-weight: 700;
}
    gap: {{ block.settings.column_gap }}px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-info-columns__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-info-columns__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin }}px 0;
  }

  .ai-info-columns__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-info-columns__link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    transition: color 0.3s ease;
  }

  .ai-info-columns__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-info-columns__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 990px) {
  .ai-info-columns__container-{{ ai_gen_id }} {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media screen and (max-width: 749px) {
  .ai-info-columns__container-{{ ai_gen_id }} {
    grid-template-columns: 1fr;
    gap: {{ block.settings.mobile_column_gap }}px;
  }
}
{% endstyle %}

<info-columns-{{ ai_gen_id }} class="ai-info-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <info-columns-{{ ai_gen_id }} class="ai-info-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-info-columns__container-{{ ai_gen_id }}">

    <!-- Company & Trust -->
    <div class="ai-info-columns__column-{{ ai_gen_id }}">
      <h3 class="ai-info-columns__heading-{{ ai_gen_id }}">
        Company & Trust
      </h3>

      <ul class="ai-info-columns__list-{{ ai_gen_id }}">
        <li>
          <a href="/pages/about-us" class="ai-info-columns__link-{{ ai_gen_id }}">
            About Belofay
          </a>
        </li>

        

        <li>
          <a href="/pages/contact" class="ai-info-columns__link-{{ ai_gen_id }}">
            Contact Us
          </a>
        </li>
      </ul>
    </div>

    <!-- Help & Support -->
    <div class="ai-info-columns__column-{{ ai_gen_id }}">
      <h3 class="ai-info-columns__heading-{{ ai_gen_id }}">
        Help & Support
      </h3>

      <ul class="ai-info-columns__list-{{ ai_gen_id }}">

        {% if shop.shipping_policy.url != blank %}
          <li>
            <a href="{{ shop.shipping_policy.url }}" class="ai-info-columns__link-{{ ai_gen_id }}">
              Delivery Information
            </a>
          </li>
        {% endif %}

        <li>
          <a href="/pages/contact" class="ai-info-columns__link-{{ ai_gen_id }}">
            Order Support
          </a>
        </li>

        {% if shop.refund_policy.url != blank %}
          <li>
            <a href="{{ shop.refund_policy.url }}" class="ai-info-columns__link-{{ ai_gen_id }}">
              Returns & Refunds
            </a>
          </li>
        {% endif %}

      </ul>
    </div>

    <!-- Policies -->
    <div class="ai-info-columns__column-{{ ai_gen_id }}">
      <h3 class="ai-info-columns__heading-{{ ai_gen_id }}">
        Policies
      </h3>

      <ul class="ai-info-columns__list-{{ ai_gen_id }}">

        {% if shop.privacy_policy.url != blank %}
          <li>
            <a href="{{ shop.privacy_policy.url }}" class="ai-info-columns__link-{{ ai_gen_id }}">
              Privacy Policy
            </a>
          </li>
        {% endif %}

        {% if shop.terms_of_service.url != blank %}
          <li>
            <a href="{{ shop.terms_of_service.url }}" class="ai-info-columns__link-{{ ai_gen_id }}">
              Terms & Conditions
            </a>
          </li>
        {% endif %}

        {% if shop.refund_policy.url != blank %}
          <li>
            <a href="{{ shop.refund_policy.url }}" class="ai-info-columns__link-{{ ai_gen_id }}">
              Returns & Refund Policy
            </a>
          </li>
        {% endif %}

        {% if shop.shipping_policy.url != blank %}
          <li>
            <a href="{{ shop.shipping_policy.url }}" class="ai-info-columns__link-{{ ai_gen_id }}">
              Shipping Policy
            </a>
          </li>
        {% endif %}

      </ul>
    </div>

    <!-- Contact Details -->
    <div class="ai-info-columns__column-{{ ai_gen_id }}">
      <h3 class="ai-info-columns__heading-{{ ai_gen_id }}">
        Contact Details
      </h3>

      <div class="ai-info-columns__text-{{ ai_gen_id }}">
        <p><strong>Phone Number</strong><br>
        +44 7735 860185</p>

        <p><strong>Email Address</strong><br>
        hello@belofay.co.uk</p>

        <p><strong>Customer Service Hours</strong><br>
        Monday – Friday<br>
        9:00am – 5:00pm</p>
      </div>
    </div>

  </div>
</info-columns-{{ ai_gen_id }}>
</info-columns-{{ ai_gen_id }}>

<script>
  (function() {
    class InfoColumns{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('info-columns-{{ ai_gen_id }}', InfoColumns{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Info columns",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "About us"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "Heading",
      "default": "About us"
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "Text",
      "default": "<p>We are dedicated to providing quality products and exceptional service to our customers.</p>"
    },
    {
      "type": "header",
      "content": "Customer services"
    },
    {
      "type": "text",
      "id": "services_heading",
      "label": "Heading",
      "default": "Customer services"
    },
    {
      "type": "text",
      "id": "service_link_2_text",
      "label": "Link 2 text",
      "default": "Shipping information"
    },
    {
      "type": "url",
      "id": "service_link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "header",
      "content": "Policies"
    },
    {
      "type": "text",
      "id": "policies_heading",

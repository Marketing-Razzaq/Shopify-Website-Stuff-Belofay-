      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_column_gap",
      "label": "Mobile column gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "heading_margin",
      "label": "Heading margin",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#2c332f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#efecec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#efecec"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#efecec"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#ffffff"
